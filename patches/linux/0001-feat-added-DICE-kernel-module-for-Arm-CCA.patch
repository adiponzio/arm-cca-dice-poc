diff --git a/drivers/virt/coco/dice-crypto-guest/Kconfig b/drivers/virt/coco/dice-crypto-guest/Kconfig
new file mode 100644
index 000000000000..94198e710d90
--- /dev/null
+++ b/drivers/virt/coco/dice-crypto-guest/Kconfig
@@ -0,0 +1,12 @@
+config REALM_DICE
+    tristate "Arm CCA Realm DICE Signing Interface"
+    depends on ARM_CCA_GUEST
+    help
+      Provides a character device (/dev/realm_dice) that allows
+      Realm userspace to request DICE signing from the RMM via RSI.
+
+      This requires a modified RMM that supports the custom
+      RSI_DICE_SIGN_FID SMC call.
+      
+      To compile this driver as a module, choose M here: the module
+      will be called realm_dice. If built into the kernel, choose Y.
diff --git a/drivers/virt/coco/dice-crypto-guest/Makefile b/drivers/virt/coco/dice-crypto-guest/Makefile
new file mode 100644
index 000000000000..6ee8e40880e3
--- /dev/null
+++ b/drivers/virt/coco/dice-crypto-guest/Makefile
@@ -0,0 +1,3 @@
+#obj-$(CONFIG_REALM_DICE) += dice-crypto-guest.o
+obj-$(CONFIG_ARM_CCA_GUEST) += dice-crypto-guest.o
+#obj-y += dice-crypto-guest.o
diff --git a/drivers/virt/coco/dice-crypto-guest/dice-crypto-guest.c b/drivers/virt/coco/dice-crypto-guest/dice-crypto-guest.c
new file mode 100644
index 000000000000..20418bcb90cc
--- /dev/null
+++ b/drivers/virt/coco/dice-crypto-guest/dice-crypto-guest.c
@@ -0,0 +1,186 @@
+#include <linux/module.h>
+#include <linux/miscdevice.h>
+#include <linux/fs.h>
+#include <linux/uaccess.h>
+#include <linux/arm-smccc.h>
+#include <linux/io.h>
+#include <linux/gfp.h>
+#include <linux/slab.h>
+
+#include <linux/realm_dice_abi.h>
+
+#define DRIVER_NAME "realm_dice"
+
+/* Custom RSI FID for DICE operations (OEM range) */
+#define RSI_DICE_SIGN_FID 0xC40001B0
+
+
+
+static long realm_dice_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct realm_dice_req req;
+	void *kbuf;
+	phys_addr_t ipa;
+	struct arm_smccc_res res;
+	size_t actual_out_size = 0;
+	__u64 target_ptr;
+	long ret = 0;
+	
+	if (copy_from_user(&req, (void __user *)arg, sizeof(req)))
+		return -EFAULT;
+	
+	///* Enforce size limits to fit within a single 4KB memory page */
+	//if (req.payload_len > PAGE_SIZE || req.sig_len > PAGE_SIZE)
+	//	return -EINVAL;
+	
+	/* Allocate a page-aligned buffer to ensure clean memory boundaries for RMM */
+	kbuf = (void *)__get_free_page(GFP_KERNEL);
+	if (!kbuf)
+		return -ENOMEM;
+	
+	/* Zero the page to prevent leaking unrelated kernel data to the RMM */
+	memset(kbuf, 0, PAGE_SIZE);
+
+	/* Copy userspace input only for operations which needs that. */
+	if (_IOC_DIR(cmd) & _IOC_WRITE) {
+		if (copy_from_user(kbuf,
+				   (const void __user *)(uintptr_t)req.sign.payload,
+				   req.sign.payload_len)) {
+			ret = -EFAULT;
+			goto out_free;
+		}
+	}
+
+	//if (copy_from_user(kbuf, (const void __user *)(uintptr_t)req.payload, req.payload_len)) {
+	//	ret = -EFAULT;
+	//	goto out_free;
+	//}
+	
+	/* Translate the kernel virtual address to Intermediate Physical Address (IPA) */
+	ipa = virt_to_phys(kbuf);
+	
+	/* 
+	 * Trap to RMM (R-EL2).
+	 * x0 = FID
+	 * x1 = Function ID
+	 * x1 = Buffer IPA
+	 * x2 = Payload length
+	 * x3 = Expected signature length
+	 */
+	switch (cmd) {
+	case REALM_DICE_IOC_SIGN_RAK:
+		arm_smccc_smc(RSI_DICE_SIGN_FID, RSI_DICE_OP_SIGN_RAK,
+			      ipa, req.sign.payload_len, req.sign.sig_len,
+			      0, 0, 0, &res);
+		break;
+	case REALM_DICE_IOC_SIGN_RIK:
+		arm_smccc_smc(RSI_DICE_SIGN_FID, RSI_DICE_OP_SIGN_RIK,
+			      ipa, req.sign.payload_len, req.sign.sig_len,
+			      0, 0, 0, &res);
+		break;
+	case REALM_DICE_IOC_GET_CERT_RAK:
+		/* No payload length passed */
+		arm_smccc_smc(RSI_DICE_SIGN_FID, RSI_DICE_OP_GET_CERT_RAK,
+			      ipa, 0, req.cert.cert_buf_size,
+			      0, 0, 0, &res);
+		break;
+	case REALM_DICE_IOC_GET_CERT_RIK:
+		/* No payload length passed */
+		arm_smccc_smc(RSI_DICE_SIGN_FID, RSI_DICE_OP_GET_CERT_RIK,
+			      ipa, 0, req.cert.cert_buf_size,
+			      0, 0, 0, &res);
+		break;
+	case REALM_DICE_IOC_GET_CERT_CHAIN:
+		/* No payload length passed */
+		arm_smccc_smc(RSI_DICE_SIGN_FID, RSI_DICE_OP_GET_CERT_CHAIN,
+			      ipa, 0, req.cert.cert_buf_size,
+			      0, 0, 0, &res);
+		break;
+	default:
+		return -ENOTTY;
+	}
+	
+	/* Check the RMM return code (assuming 0 is success) */
+	if (res.a0 != 0) {
+		pr_err("%s: RMM signing failed with error %ld\n", DRIVER_NAME, res.a0);
+		ret = -EIO;
+		goto out_free;
+	}
+
+	actual_out_size = res.a1; 
+	/* Copy the output in the userspace only if required by the IOC. */
+	if (_IOC_DIR(cmd) & _IOC_READ) {
+		/* Use actual_out_size so we don't copy back trailing zeros */
+		if (cmd == REALM_DICE_IOC_SIGN_RAK || cmd == REALM_DICE_IOC_SIGN_RIK)
+			target_ptr = req.sign.signature;
+		else
+			target_ptr = req.cert.cert_buf;
+		
+		if (copy_to_user((void __user *)(uintptr_t)target_ptr, kbuf, actual_out_size)) {
+			ret = -EFAULT;
+			goto out_free;
+		}
+
+		/* Update the struct with the real size and write it back */
+		if (cmd == REALM_DICE_IOC_SIGN_RAK || cmd == REALM_DICE_IOC_SIGN_RIK) {
+			req.sign.sig_len = actual_out_size;
+		} else {
+			req.cert.cert_len = actual_out_size;
+		}
+		
+		if (copy_to_user((void __user *)arg, &req, sizeof(req))) {
+			ret = -EFAULT;
+			goto out_free;
+		}
+	}
+	///* Copy the generated signature back to userspace */
+	//if (copy_to_user((void __user *)(uintptr_t)req.signature, kbuf, req.sig_len)) {
+	//	ret = -EFAULT;
+	//	goto out_free;
+	//}
+
+out_free:
+	/* Zero the memory again before freeing to scrub cryptographic material */
+	memset(kbuf, 0, PAGE_SIZE);
+	free_page((unsigned long)kbuf);
+	return ret;
+}
+
+static const struct file_operations realm_dice_fops = {
+	.owner          = THIS_MODULE,
+	.unlocked_ioctl = realm_dice_ioctl,
+	.llseek         = noop_llseek,
+};
+
+static struct miscdevice realm_dice_miscdev = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name  = DRIVER_NAME,
+	.fops  = &realm_dice_fops,
+};
+
+static int __init realm_dice_init(void)
+{
+	int ret;
+	
+	ret = misc_register(&realm_dice_miscdev);
+	if (ret) {
+		pr_err("%s: Failed to register misc device (ret=%d)\n", DRIVER_NAME, ret);
+		return ret;
+	}
+	
+	pr_info("%s: Registered custom Arm CCA DICE signing device\n", DRIVER_NAME);
+	return 0;
+}
+
+static void __exit realm_dice_exit(void)
+{
+	misc_deregister(&realm_dice_miscdev);
+	pr_info("%s: Deregistered\n", DRIVER_NAME);
+}
+
+module_init(realm_dice_init);
+module_exit(realm_dice_exit);
+
+MODULE_AUTHOR("Antonio Di Ponzio");
+MODULE_DESCRIPTION("Realm DICE Signing Interface for Arm CCA");
+MODULE_LICENSE("GPL");
diff --git a/include/uapi/linux/realm_dice_abi.h b/include/uapi/linux/realm_dice_abi.h
new file mode 100644
index 000000000000..1af19e11c6bb
--- /dev/null
+++ b/include/uapi/linux/realm_dice_abi.h
@@ -0,0 +1,51 @@
+#ifndef REALM_DICE_ABI_H
+#define REALM_DICE_ABI_H
+
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+#define RSI_DICE_OP_SIGN_RAK        0
+#define RSI_DICE_OP_SIGN_RIK        1
+#define RSI_DICE_OP_GET_CERT_RAK        2
+#define RSI_DICE_OP_GET_CERT_RIK        3
+#define RSI_DICE_OP_GET_CERT_CHAIN      4
+
+//struct realm_dice_sign_args {
+//	__u64 payload;     /* Cast void* to __u64 for 32/64-bit compatibility */
+//	__u64 payload_len;
+//	__u64 signature;
+//	__u64 sig_len;
+//};
+//
+//struct realm_dice_get_cert_output {
+//	__64 cert_buf;
+//	__64 cert_len;
+//};
+
+struct realm_dice_req {
+    union {
+        /* Used for REALM_DICE_IOC_SIGN_* */
+        struct {
+		__u64 payload;      /* User pointer to data to sign */
+        	__u64 payload_len;
+        	__u64 signature;    /* User pointer for output */
+        	__u64 sig_len;      /* In: buffer size, Out: actual size */
+        } sign;
+
+        /* Used for REALM_DICE_IOC_GET_CERT_* */
+        struct {
+		__u64 cert_buf;	  /* User pointer for output */
+		__u64 cert_buf_size;
+        	__u64 cert_len;       /* In: buffer size, Out: actual size */
+        } cert;
+    };
+};
+
+
+#define REALM_DICE_IOC_SIGN_RAK		_IOWR('D', 0, struct realm_dice_req)
+#define REALM_DICE_IOC_SIGN_RIK		_IOWR('D', 1, struct realm_dice_req)
+#define REALM_DICE_IOC_GET_CERT_RAK	_IOR('D', 2, struct realm_dice_req)
+#define REALM_DICE_IOC_GET_CERT_RIK	_IOR('D', 3, struct realm_dice_req)
+#define REALM_DICE_IOC_GET_CERT_CHAIN	_IOR('D', 4, struct realm_dice_req)
+
+#endif /* REALM_DICE_ABI_H */
-- 
