diff --git a/drivers/virt/coco/dice-crypto-guest/Kconfig b/drivers/virt/coco/dice-crypto-guest/Kconfig
new file mode 100644
index 000000000000..5969da3def32
--- /dev/null
+++ b/drivers/virt/coco/dice-crypto-guest/Kconfig
@@ -0,0 +1,15 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config REALM_DICE
+	tristate "Arm CCA Realm DICE Signing Interface"
+	depends on ARM_CCA_GUEST
+	default ARM_CCA_GUEST
+	help
+	  Provides a character device (/dev/realm_dice) that allows
+	  Realm userspace to request DICE signing and X.509 certificate
+	  export from the RMM via RSI.
+
+	  This requires a modified RMM that supports the custom
+	  SMC_RSI_DICE_CRYPTO SMC call.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called dice-crypto-guest. If built into the kernel, choose Y.
