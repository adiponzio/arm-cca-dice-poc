diff --git a/runtime/rsi/realm_dice_operations.c b/runtime/rsi/realm_dice_operations.c
new file mode 100644
index 0000000..811545a
--- /dev/null
+++ b/runtime/rsi/realm_dice_operations.c
@@ -0,0 +1,173 @@
+#include <stdint.h>
+#include <stdbool.h>
+#include <buffer.h>
+#include <granule.h>
+#include <realm.h>
+#include <string.h>
+#include <rsi-handler.h>
+
+#include <dice_layering_app.h>
+
+/*
+ * Since the realm certificates are stored in the struct rd, there is
+ * no need to call the dice application.
+ */
+static int get_realm_cert(uint8_t *output, size_t output_size,
+			  size_t *output_len, enum cert_cmd cert_req,
+			  struct crypto_identity *crypto_data)
+{
+	int ret = 0;
+	switch (cert_req) {
+	case RAK_CERT:
+	{
+		if (crypto_data->rak_cert_len > output_size) {
+			ret = -1;
+		} else {
+			*output_len = crypto_data->rak_cert_len;
+			memcpy(output, crypto_data->rak_cert, *output_len);
+		}
+		break;
+	}
+
+	case RIK_CERT:
+	{
+		if (crypto_data->rik_cert_len > output_size) {
+			ret = -1;
+		} else {
+			*output_len = crypto_data->rik_cert_len;
+			memcpy(output, crypto_data->rik_cert, *output_len);
+		}
+		break;
+	}
+
+	default:
+		ret = -1;
+	}
+
+	return ret;
+}
+
+/*
+ * Main handler called when the CPU traps the SMC_RSI_DICE_CRYPTO call
+ * args[0] = FID, args[1] = OP, args[2] = In_IPA, args[3] = Out_IPA, args[4] = Out_Size
+ */
+void handle_rsi_dice_crypto(struct rec *rec, struct rsi_result *res)
+{
+    /* 1. Extract arguments from the Realm Execution Context */
+	unsigned long op_id = rec->regs[1];
+	unsigned long shared_ipa = rec->regs[2];
+	unsigned long input_len  = rec->regs[3];
+	//unsigned long out_size = rec->regs[4];
+
+	unsigned long status = RSI_SUCCESS;
+	//void *in_pa = NULL;
+	int crypto_ret = -1;
+
+	enum s2_walk_status walk_status;
+	struct s2_walk_result walk_res = { 0UL };
+	struct granule *gr;
+	uintptr_t shared_addr;
+
+	struct rd *rd;
+	struct crypto_identity dice_id;
+
+	uint8_t input_buf[MAX_PAYLOAD_LEN];
+	uint8_t output_buf[1024];
+	size_t output_len;
+	/*
+	 * Map the input and output pages
+	 */
+	walk_status = realm_ipa_to_pa(rec, shared_ipa, &walk_res);
+
+	if (walk_status == WALK_FAIL) {
+		if (walk_res.ripas_val == RIPAS_EMPTY) {
+			res->smc_res.x[0] = RSI_ERROR_INPUT;
+		} else {
+			/*
+			 * Translation failed, IPA is not mapped.
+			 * Return to NS host to fix the issue.
+			 */
+			res->action = STAGE_2_TRANSLATION_FAULT;
+			res->rtt_level = walk_res.rtt_level;
+		}
+		return;
+	}
+
+	gr = find_granule(walk_res.pa);
+
+	shared_addr = (uintptr_t)buffer_granule_map(gr, SLOT_RSI_CALL);
+
+	/* Copy the 64-byte hash to the local RMM stack buffer */
+	(void)memcpy((void *)input_buf, (void *)(shared_addr), 64);
+
+	granule_lock(rec->realm_info.g_rd, GRANULE_STATE_RD);
+	rd = buffer_granule_map(rec->realm_info.g_rd, SLOT_RD);
+	assert(rd != NULL);
+
+	/*
+	 * If needed according to op_id, copy the crypto identity from the
+	 * realm descriptor granule
+	 */
+	if (op_id == RSI_DICE_OP_SIGN_RAK || op_id == RSI_DICE_OP_SIGN_RIK) {
+		
+		memcpy((void*)&dice_id, (void*)&rd->crypto_data,
+		       sizeof(struct crypto_identity));
+
+	}
+
+	
+	switch (op_id) {
+	case RSI_DICE_OP_SIGN_RAK:
+		crypto_ret = dice_layering_ecdsa_sign(input_buf, input_len,
+						      dice_id.rak, sizeof(dice_id.rak),
+						      output_buf, sizeof(output_buf),
+						      &output_len);
+		break;
+	case RSI_DICE_OP_SIGN_RIK:
+		crypto_ret = dice_layering_ecdsa_sign(input_buf, input_len,
+						      dice_id.rik, sizeof(dice_id.rik),
+						      output_buf, sizeof(output_buf),
+						      &output_len);
+		break;
+	case RSI_DICE_OP_CERT_RAK:
+		crypto_ret = get_realm_cert(output_buf, sizeof(output_buf),
+					    &output_len, RAK_CERT,
+					    &rd->crypto_data);
+		break;
+	case RSI_DICE_OP_CERT_RIK:
+		crypto_ret = get_realm_cert(output_buf, sizeof(output_buf),
+					    &output_len, RIK_CERT,
+					    &rd->crypto_data);
+		break;
+	case RSI_DICE_OP_CERT_CHAIN:
+		crypto_ret = dice_layering_app_get_realm_cert(output_buf, sizeof(output_buf),
+							      &output_len);
+		break;
+	default:
+		res->smc_res.x[0] = RSI_ERROR_INPUT;
+		return;
+	}
+
+	buffer_unmap(rd);
+	granule_unlock(rec->realm_info.g_rd);
+
+	(void)memcpy((void *)(shared_addr), output_buf, output_len);
+	buffer_unmap((void *)shared_addr);
+	granule_unlock(walk_res.llt);
+	/* If the input is needed (according to the op_id), */
+	//if (op_id == RSI_DICE_OP_SIGN_RAK || op_id == RSI_DICE_OP_SIGN_RIK) {
+	//	shared_addr = (uintptr_t)buffer_granule_map(gr, SLOT_RSI_CALL);
+
+	//	(void)memcpy((void *)(shared_addr), output_buf, output_len);
+	//	buffer_unmap((void *)shared_addr);
+	//	granule_unlock(walk_res.llt);
+	//}
+
+	(void)crypto_ret;
+
+	/* 3. Populate the results to return to the Realm */
+	res->smc_res.x[0] = status;
+	res->smc_res.x[1] = output_len;
+
+	res->action = UPDATE_REC_RETURN_TO_REALM;
+}
