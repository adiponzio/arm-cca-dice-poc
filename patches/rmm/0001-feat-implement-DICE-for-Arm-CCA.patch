diff --git a/app/dice_layering/rmm_stub/include/dice_layering_defs.h b/app/dice_layering/rmm_stub/include/dice_layering_defs.h
new file mode 100644
index 0000000..ddf0383
--- /dev/null
+++ b/app/dice_layering/rmm_stub/include/dice_layering_defs.h
@@ -0,0 +1,121 @@
+#ifndef DICE_LAYERING_APP_DEFS_H
+#define DICE_LAYERING_APP_DEFS_H
+
+#include <attest_defs.h>
+#include <smc-rmi.h>
+
+#define DICE_LAYERING_APP_FUNC_INIT		1
+#define DICE_LAYERING_APP_FUNC_GEN_REALM_DATA	2
+#define DICE_LAYERING_APP_FUNC_SIGN_OPERATION 3
+#define DICE_LAYERING_APP_FUNC_GET_CERT 4
+
+#define ECDSA_KEY_LEN 32U /*bytes*/
+#define MAX_CERT_LEN 400U
+#define CDI_LEN 32U
+
+#define MAX_PAYLOAD_LEN 64
+
+/*
+ * The data passed through the manifest from the tfa layer are needed
+ * for the initialization of the dice_layering app.
+ *
+ * The same struct is defined in the include/drivers/dice_layering/dice_layering.h
+ * file of the tfa repository.
+ */
+struct dice_rmm_data {
+	uint8_t cdi_rmm[32];
+	/*
+	 * Certificate of the RAK public key. The RAK is deterministically generated
+	 * from the cdi_rmm. So, the RMM can re-derive it. The usage of a different
+	 * key can be detected from the verifier since the entire CoT must be sent.
+	 */
+	uint8_t cert_rmm[400];
+	size_t cert_rmm_len;
+	/*
+	 * Certificate of the TFA public key. This is the parent of the
+	 * RAK certificate in the CoT.
+	 */
+	uint8_t cert_tfa[400];
+	size_t cert_tfa_len;
+};
+
+struct cert_chain {
+	uint8_t cert_rmm[400];
+	size_t cert_rmm_len;
+
+	uint8_t cert_tfa[400];
+	size_t cert_tfa_len;
+};
+
+/*
+ * This struct contains the data passed to the el0 application for the
+ * initialization of the Realm cryptographic identity. This data will be used
+ * to compute the TCI(Realm). Such data are:
+ * - the Realm Initial Measurement (RIM)
+ * - the algorithm used to compute the RIM
+ * - the Realm Personalization Value
+ *
+ * The struct must be passed through the el2 shared page.
+ */
+struct dice_realm_data {
+	uint8_t rim[MAX_MEASUREMENT_SIZE];
+	enum hash_algo algorithm;
+	uint8_t rpv[RPV_SIZE];
+};
+
+/*
+ * The following struct holds the cryptographic data for each Realm.
+ * For each Realm, it must be stored:
+ *   - the CDI
+ *   - the Realm Attestation Key (RAK)
+ *   - the x509 certificate of the RAK public key
+ *   - the Realm Identity Key (RIK)
+ *   - the x509 certificate of the RIK public key
+ *
+ * These values msut be stored in struct rd for each Realm.
+ * It is the output of the dice_application on the shared page.
+ */
+struct crypto_identity {
+
+	uint8_t cdi[CDI_LEN];
+	/*
+	 * Only the secret key is needed to be stored since
+	 * the public key is saved in the certificate.
+	 */
+	uint8_t rak[ECDSA_KEY_LEN];
+	uint8_t rak_cert[MAX_CERT_LEN];
+	size_t rak_cert_len;
+
+	uint8_t rik[ECDSA_KEY_LEN];
+	uint8_t rik_cert[MAX_CERT_LEN];
+	size_t rik_cert_len;
+};
+
+enum cert_cmd {
+	RAK_CERT,
+	RIK_CERT,
+	CHAIN_CERT
+};
+
+struct cert_output {
+	uint8_t cert[MAX_CERT_LEN];
+	size_t cert_len;
+};
+
+/*
+ * Pass the values to the application for performing a
+ * signing operation.
+ */
+struct sign_operation_input {
+	uint8_t payload[MAX_PAYLOAD_LEN];
+	size_t payload_len;
+	uint8_t key[ECDSA_KEY_LEN];
+	size_t key_len;
+};
+
+struct sign_operation_output {
+	uint8_t signature[128];
+	size_t signature_len;
+};
+
+#endif /* DICE_LAYERING_APP_DEFS_H */
diff --git a/app/dice_layering/rmm_stub/src/app_support/dice_layering_app.c b/app/dice_layering/rmm_stub/src/app_support/dice_layering_app.c
new file mode 100644
index 0000000..ee896b3
--- /dev/null
+++ b/app/dice_layering/rmm_stub/src/app_support/dice_layering_app.c
@@ -0,0 +1,242 @@
+#include <app_common.h>
+#include <assert.h>
+#include <cpuid.h>
+#include <debug.h>
+#include <errno.h>
+#include <limits.h>
+#include <dice_layering_defs.h>
+#include <rmm_el3_ifc.h>
+#include <dice_layering_app.h>
+//#include <aarch64/plat_cmn_arch.h>
+#include <import_sym.h>
+#include <simd.h>
+/*
+ * Required page count is the sum of:
+ * - pages for stack
+ * - pages for heap
+ * - three for shared, page table and (?)
+ *
+ * So the minimum is 5.
+ */
+#define DICE_LAYERING_APP_PAGE_COUNT 11U
+
+static unsigned char rmm_dice_layering_app_pages
+		[MAX_CPUS][DICE_LAYERING_APP_PAGE_COUNT][GRANULE_SIZE] __aligned(GRANULE_SIZE);
+static struct app_data_cfg rmm_dice_layering_app_datas[MAX_CPUS] __aligned(GRANULE_SIZE);
+static bool dice_layering_app_init_done[MAX_CPUS];
+
+extern struct dice_manifest_data local_dice_data;
+
+/*
+ * Initialize the memory pages for the app.
+ */
+static int dice_layering_app_init_data(struct app_data_cfg *app_data,
+				       uintptr_t granule_pas[],
+				       size_t granule_pa_count,
+				       void *granule_va_start)
+{
+	assert(!dice_layering_app_init_done[my_cpuid()]);
+	return app_init_data(app_data,
+			     DICE_LAYERING_APP_ID,
+			     granule_pas,
+			     granule_pa_count,
+			     granule_va_start);
+
+}
+
+void get_dice_data_from_manifest(struct dice_manifest_data *dice_ptr)
+{
+	(void)dice_ptr;
+	assert(dice_ptr != NULL);
+
+}
+/*
+ * Initialize the cryptographic identity of the RMM inside the app.
+ */
+static int dice_layering_app_init_crypto(struct app_data_cfg *app_data)
+{
+	unsigned long ret;
+	//struct dice_manifest_data dice_ptr;
+
+	(void)ret;
+	(void)app_data;
+
+	//get_dice_data_from_manifest(&dice_ptr);
+	assert(&local_dice_data != NULL);
+	
+	app_map_shared_page(app_data);
+	(void)memcpy(app_data->el2_shared_page, (void *)&local_dice_data,
+		     sizeof(struct dice_manifest_data));
+
+	SIMD_FPU_ALLOW(
+	ret = app_run(app_data, DICE_LAYERING_APP_FUNC_INIT, 0, 0, 0, 0));
+	app_unmap_shared_page(app_data);
+
+	if (ret > (unsigned long)INT_MAX) {
+		return - EINVAL;
+	} else {
+		return (int)ret;
+	}
+}
+
+int dice_layering_app_init_realm_identity(struct crypto_identity *output,
+					  const unsigned char *rim,
+					  const unsigned char *rpv,
+					  enum hash_algo algorithm)
+{
+	unsigned long ret;
+	unsigned int cpuid = my_cpuid();
+
+	if(!dice_layering_app_init_done[cpuid])
+		return 0;
+
+	struct app_data_cfg *app_data = &rmm_dice_layering_app_datas[cpuid];
+
+	app_map_shared_page(app_data);
+	struct dice_realm_data *dice_realm = (struct dice_realm_data*)app_data->el2_shared_page;
+
+	memcpy(dice_realm->rim, rim, sizeof(dice_realm->rim));
+	memcpy(dice_realm->rpv, rpv, sizeof(dice_realm->rpv));
+	dice_realm->algorithm = algorithm;
+
+	SIMD_FPU_ALLOW(
+	ret = app_run(app_data, DICE_LAYERING_APP_FUNC_GEN_REALM_DATA, 0, 0, 0, 0));
+
+	/*TODO: check return value and copy the content of shared page to output*/
+	memcpy(output, app_data->el2_shared_page, sizeof(struct crypto_identity));
+
+	app_unmap_shared_page(app_data);
+
+	if (ret > (unsigned long)INT_MAX) {
+		return - EINVAL;
+	} else {
+		return (int)ret;
+	}
+
+}
+
+int dice_layering_ecdsa_sign(const uint8_t *payload, size_t payload_len,
+			     const uint8_t *key, size_t key_len,
+			     uint8_t *output, size_t output_size,
+			     size_t *output_len)
+{
+	unsigned long ret;
+	unsigned int cpuid = my_cpuid();
+
+	if(!dice_layering_app_init_done[cpuid])
+		return 0;
+
+	struct sign_operation_output *out;
+
+	struct app_data_cfg *app_data = &rmm_dice_layering_app_datas[cpuid];
+	app_map_shared_page(app_data);
+
+	struct sign_operation_input *inp = (struct sign_operation_input*)app_data->el2_shared_page;
+
+	if (payload_len > sizeof(inp->payload))
+		assert(false);
+
+	memcpy(&inp->payload, payload, payload_len);
+	inp->payload_len = payload_len;
+
+	if (key_len > sizeof(inp->key))
+		assert(false);
+
+	memcpy(&inp->key, key, key_len);
+	inp->key_len = key_len;
+
+	SIMD_FPU_ALLOW(
+	ret = app_run(app_data, DICE_LAYERING_APP_FUNC_SIGN_OPERATION, 0, 0, 0, 0));
+
+	out = (struct sign_operation_output*)app_data->el2_shared_page;
+
+	*output_len = out->signature_len > output_size ? output_size : out->signature_len;
+	memcpy(output, out->signature, *output_len);
+
+	app_unmap_shared_page(app_data);
+
+
+	if (ret > (unsigned long)INT_MAX) {
+		return - EINVAL;
+	} else {
+		return (int)ret;
+	}
+
+
+}
+
+int dice_layering_app_get_realm_cert(uint8_t *output, size_t output_size,
+				     size_t *output_len)
+{
+	unsigned long ret;
+	unsigned int cpuid = my_cpuid();
+	struct cert_chain *out;
+
+	if(!dice_layering_app_init_done[cpuid])
+		return 0;
+
+	struct app_data_cfg *app_data = &rmm_dice_layering_app_datas[cpuid];
+	app_map_shared_page(app_data);
+
+	SIMD_FPU_ALLOW(
+	ret = app_run(app_data, DICE_LAYERING_APP_FUNC_GET_CERT,
+		      0, 0, 0, 0));
+
+	out = (struct cert_chain*)app_data->el2_shared_page;
+
+	*output_len = sizeof(*out);
+
+	if (*output_len > output_size) {
+		ret = -1;
+		goto cleanup;
+	}
+
+	memcpy(output, (uint8_t*)out, *output_len);
+
+cleanup:
+	app_unmap_shared_page(app_data);
+	if (ret > (unsigned long)INT_MAX) {
+		return - EINVAL;
+	} else {
+		return (int)ret;
+	}
+}
+
+int dice_layering_app_init(void)
+{
+	int ret;
+	unsigned int cpuid = my_cpuid();
+
+	if(dice_layering_app_init_done[cpuid])
+		return 0;
+
+	uintptr_t granule_pas[DICE_LAYERING_APP_PAGE_COUNT];
+
+	for (size_t i = 0; i < DICE_LAYERING_APP_PAGE_COUNT; ++i) {
+		granule_pas[i] = (uintptr_t)&rmm_dice_layering_app_pages[cpuid][i][0];
+	}
+
+	ret = dice_layering_app_init_data(&rmm_dice_layering_app_datas[cpuid],
+					  granule_pas,
+					  DICE_LAYERING_APP_PAGE_COUNT,
+					  &rmm_dice_layering_app_pages[cpuid][0][0]);
+	if (ret != 0) return ret;
+
+	/*
+	 * Initialize the RMM crypto identity with the values passed
+	 * by the lower layer through the manifest.
+	 */
+	ret = dice_layering_app_init_crypto(&rmm_dice_layering_app_datas[cpuid]);
+	if (ret != 0) return ret;
+	
+	dice_layering_app_init_done[cpuid] = true;
+
+	return ret;
+}
+
+void dice_layering_app_get_bss(uintptr_t *bss_pa, size_t *bss_size)
+{
+	static char dice_layering_app_bss[GRANULE_SIZE] __aligned(GRANULE_SIZE);
+	*bss_pa = (uintptr_t)dice_layering_app_bss;
+	*bss_size = sizeof(dice_layering_app_bss);
+}
