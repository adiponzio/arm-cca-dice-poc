diff --git a/app/dice_layering/el0_app/CMakeLists.txt b/app/dice_layering/el0_app/CMakeLists.txt
new file mode 100644
index 0000000..2b37101
--- /dev/null
+++ b/app/dice_layering/el0_app/CMakeLists.txt
@@ -0,0 +1,128 @@
+# TODO: The C file generating logic is general for all the apps.
+# need to move it to a common location somehow.
+
+# The apps are not included in the CBMC analysis
+if(RMM_CBMC_STATIC_ANALYSIS)
+    add_library(rmm-app-dice-layering-elf INTERFACE)
+    return()
+endif()
+
+add_subdirectory("mbedtls_dice_layering")
+
+include(ArmTargetLinkerScript)
+
+find_package(Python3 REQUIRED)
+find_program(GEN_APP_BIN "gen_app_bin.py"
+    PATHS ${CMAKE_SOURCE_DIR}
+    PATH_SUFFIXES app
+    DOC "gen_app_bin.py"
+    )
+
+# Compile the app as a separate executable (add_library would skip the linking step)
+add_executable(rmm-app-dice-layering-elf)
+
+set(RMM_DICE_LAYERING_APP_ID 104)
+
+arm_config_option(
+    NAME RMM_NUM_PAGES_PER_DICE_LAYERING_APP_STACK
+    HELP "Number of pages to use for the Random app stack"
+    TYPE STRING
+    DEFAULT 4
+    ADVANCED)
+
+arm_config_option(
+    NAME RMM_NUM_PAGES_PER_DICE_LAYERING_APP_HEAP
+    HELP "Number of pages to use for the Random app heap"
+    TYPE STRING
+    DEFAULT 4
+    ADVANCED)
+
+target_include_directories(rmm-app-dice-layering-elf
+    PRIVATE
+        "src"
+        "${CMAKE_CURRENT_SOURCE_DIR}/../rmm_stub/include"
+        "${CMAKE_CURRENT_SOURCE_DIR}/../../common/include"
+        "${CMAKE_CURRENT_SOURCE_DIR}/../../attestation/rmm_stub/include"
+        "${CMAKE_CURRENT_SOURCE_DIR}/../../../lib/smc/include")
+
+target_link_libraries(rmm-app-dice-layering-elf
+    PRIVATE
+        rmm-app-common-el0_app
+        rmm-app-dice-layering-mbedtls
+        rmm-lib-common
+        rmm-lib-debug
+        rmm-lib-xlat)
+
+# Target for output directory.
+add_custom_target(dice_layering_app_output_dir
+    COMMAND "${CMAKE_COMMAND}" -E make_directory "${CMAKE_BINARY_DIR}/$<CONFIG>"
+    COMMENT "Creating output directory"
+)
+
+add_custom_command(
+    COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:rmm-app-dice-layering-elf>" "${CMAKE_BINARY_DIR}/$<CONFIG>/rmm_app_dice_layering.elf"
+    COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_FILE:rmm-app-dice-layering-elf>.map" "${CMAKE_BINARY_DIR}/$<CONFIG>/rmm_app_dice_layering.map"
+    OUTPUT rmm_app_dice_layering.elf
+    DEPENDS rmm-app-dice-layering-elf dice_layering_app_output_dir)
+
+# Create the dump file using whatever tool comes with the toolchain.
+if(CMAKE_OBJDUMP)
+    add_custom_command(
+        COMMAND "${CMAKE_OBJDUMP}" -dxS "${CMAKE_BINARY_DIR}/$<CONFIG>/rmm_app_dice_layering.elf" > "${CMAKE_BINARY_DIR}/$<CONFIG>/rmm_app_dice_layering.dump"
+        OUTPUT rmm_app_dice_layering.dump
+        DEPENDS rmm_app_dice_layering.elf)
+endif()
+
+target_sources(rmm-app-dice-layering-elf
+    PRIVATE
+        "src/dice_layering_app.c"
+        "src/dice_layering_crypto.c")
+
+if (RMM_ARCH STREQUAL fake_host)
+    target_sources(rmm-app-dice-layering-elf
+        PRIVATE "src/fake_host/dice_layering_app_host.c")
+endif()
+
+target_link_options(rmm-app-dice-layering-elf
+    PRIVATE "-Wl,-Map=$<TARGET_FILE:rmm-app-dice-layering-elf>.map")
+
+# pass the heap size to the app
+target_compile_definitions(rmm-app-dice-layering-elf
+    PRIVATE "HEAP_PAGE_COUNT=U(${RMM_NUM_PAGES_PER_DICE_LAYERING_APP_HEAP})")
+
+if(NOT RMM_ARCH STREQUAL fake_host)
+    set(COMMON_APP_LINKER_SCRIPT "${CMAKE_CURRENT_SOURCE_DIR}/../../common/el0_app/linker.lds")
+
+    arm_target_linker_script(rmm-app-dice-layering-elf "${COMMON_APP_LINKER_SCRIPT}")
+
+    set_property(TARGET rmm-app-dice-layering-elf-lds APPEND
+        PROPERTY COMPILE_DEFINITIONS "__LINKER__")
+
+    set_property(TARGET rmm-app-dice-layering-elf-lds APPEND
+        PROPERTY COMPILE_DEFINITIONS "GRANULE_SHIFT=U(${GRANULE_SHIFT})")
+
+    # Get the name of the bin file that will contain the app data
+    get_filename_component(RAW_DATA_OUTPUT_FILE ${CMAKE_BINARY_DIR}/$<CONFIG>/rmm_app_dice_layering.bin ABSOLUTE)
+
+    list(APPEND EL0_APP_BIN_LIST "${RAW_DATA_OUTPUT_FILE}")
+    set(EL0_APP_BIN_LIST ${EL0_APP_BIN_LIST} PARENT_SCOPE)
+
+    # Add a command that will run the bin file generation. Make it depend on the app elf file
+    add_custom_command(
+    OUTPUT ${RAW_DATA_OUTPUT_FILE}
+    COMMAND ${GEN_APP_BIN}
+        --elf-file $<TARGET_FILE:rmm-app-dice-layering-elf>
+        --app-name "dice_layering_app"
+        --app-id ${RMM_DICE_LAYERING_APP_ID}
+        --stack-page-count 4 #${RMM_NUM_PAGES_PER_DICE_LAYERING_APP_STACK}
+        --heap-page-count 4 #${RMM_NUM_PAGES_PER_DICE_LAYERING_APP_HEAP}
+        --out-bin ${RAW_DATA_OUTPUT_FILE}
+    DEPENDS rmm-app-dice-layering-elf rmm-app-dice-layering-elf-lds
+    )
+
+    # Add a custom target that depends on the bin file. This is necessary so that
+    # the bundled image can depend on it.
+    add_custom_target(rmm-dice-layering-app DEPENDS ${RAW_DATA_OUTPUT_FILE} rmm_app_dice_layering.dump)
+else()
+    add_custom_target(rmm-dice-layering-app DEPENDS rmm_app_dice_layering.dump)
+endif()
diff --git a/app/dice_layering/el0_app/mbedtls_dice_layering/CMakeLists.txt b/app/dice_layering/el0_app/mbedtls_dice_layering/CMakeLists.txt
new file mode 100644
index 0000000..e3f3632
--- /dev/null
+++ b/app/dice_layering/el0_app/mbedtls_dice_layering/CMakeLists.txt
@@ -0,0 +1,60 @@
+set (MBEDTLS_TARGET_PREFIX "dice_layering_")
+
+# The Mbed TLS library is not included in the CBMC analysis
+if(RMM_CBMC_STATIC_ANALYSIS)
+    add_library(rmm-app-dice-layering-mbedtls INTERFACE)
+    return()
+endif()
+
+set(MBEDTLS_SRC_DIR "${RMM_SOURCE_DIR}/ext/mbedtls")
+set(MBEDTLS_BIN_DIR "${CMAKE_CURRENT_BINARY_DIR}/mbedtls_dice_layering")
+
+# Starting Mbed TLS 3.x release, mbedtls/library/CMakeLists.txt has dependency on
+# link_to_source() function that is in mbedtls/CMakeLists.txt, so define a dummy
+# link_to_source here.
+function(link_to_source base_name)
+endfunction(link_to_source)
+
+# Ensure that the CFlags modifications are local in scope and only apply to
+# MbedTLS build
+if(RMM_FPU_USE_AT_REL2)
+    set(BACKUP_C_FLAGS "${CMAKE_C_FLAGS}")
+    # Enable using floating point registers for mbed TLS
+    string(REPLACE "-mgeneral-regs-only" "" CMAKE_C_FLAGS ${CMAKE_C_FLAGS})
+    # Enable using crypto and sha instructions
+    string(REGEX REPLACE "(march=[^\\ ]*)" "\\1+sha3+crypto+nosve" CMAKE_C_FLAGS
+        ${CMAKE_C_FLAGS})
+
+    add_subdirectory("${MBEDTLS_SRC_DIR}/library" "${MBEDTLS_BIN_DIR}/library"
+        EXCLUDE_FROM_ALL)
+
+    set(CMAKE_C_FLAGS "${BACKUP_C_FLAGS}")
+else()
+    add_subdirectory("${MBEDTLS_SRC_DIR}/library" "${MBEDTLS_BIN_DIR}/library"
+        EXCLUDE_FROM_ALL)
+endif()
+
+add_library(rmm-app-dice-layering-mbedtls INTERFACE)
+
+# Patching is done by the original mbedTLS build. So make sure that this
+# library depends on the original one.
+add_dependencies(rmm-app-dice-layering-mbedtls rmm-mbedtls)
+
+target_include_directories(rmm-app-dice-layering-mbedtls INTERFACE
+    "${RMM_SOURCE_DIR}/app/dice_layering/el0_app/mbedtls_dice_layering"
+    "${MBEDTLS_SRC_DIR}/include")
+target_compile_definitions(rmm-app-dice-layering-mbedtls INTERFACE
+    "-DMBEDTLS_CONFIG_FILE=<rmm_mbedtls_config_dice_layering.h>")
+
+# Include targets mbedcrypto and mbedx509
+set(MBEDTLS_LIBS mbedcrypto mbedx509)
+
+foreach(MBEDTLS_LIB IN ITEMS ${MBEDTLS_LIBS})
+    target_include_directories(${MBEDTLS_TARGET_PREFIX}${MBEDTLS_LIB} PUBLIC
+        "${RMM_SOURCE_DIR}/app/dice_layering/el0_app/mbedtls_dice_layering"
+        "${MBEDTLS_SRC_DIR}/include")
+    target_compile_definitions(${MBEDTLS_TARGET_PREFIX}${MBEDTLS_LIB} PUBLIC
+        "-DMBEDTLS_CONFIG_FILE=<rmm_mbedtls_config_dice_layering.h>")
+    target_link_libraries(rmm-app-dice-layering-mbedtls INTERFACE ${MBEDTLS_TARGET_PREFIX}${MBEDTLS_LIB})
+    target_link_libraries(${MBEDTLS_TARGET_PREFIX}${MBEDTLS_LIB} PRIVATE rmm-app-common-el0_app)
+endforeach()
diff --git a/app/dice_layering/el0_app/mbedtls_dice_layering/rmm_mbedtls_config_dice_layering.h b/app/dice_layering/el0_app/mbedtls_dice_layering/rmm_mbedtls_config_dice_layering.h
new file mode 100644
index 0000000..5632575
--- /dev/null
+++ b/app/dice_layering/el0_app/mbedtls_dice_layering/rmm_mbedtls_config_dice_layering.h
@@ -0,0 +1,117 @@
+#include <limits.h>
+#include <stddef.h>
+#include <stdio.h>
+
+/*
+ * This MbedTLS version contains an unused but set variable int the
+ * copy_from_psa() function.
+ *
+ * As workaround, disable such checks for the library sources.
+ */
+#if defined(__GNUC__) || defined(__clang__)
+#pragma GCC diagnostic ignored "-Wunused-but-set-variable"
+#endif
+
+/*
+ * As in tf-a, the strncpy function is removed from the libc for security
+ * reasons. This is the same implementation provided in the tf-a config
+ * file.
+ */
+static inline char *strncpy(char *dst, const char *src, size_t n) {
+    size_t i;
+    for (i = 0; i < n && src[i] != '\0'; i++) {
+        dst[i] = src[i];
+    }
+    for ( ; i < n; i++) {
+        dst[i] = '\0';
+    }
+    return dst;
+}
+
+/* This file is compatible with release 3.6.0 */
+#define MBEDTLS_CONFIG_VERSION         0x03060000
+
+#define MBEDTLS_USE_PSA_CRYPTO
+
+/*
+ * Configuration file to build mbed TLS with the required features for
+ * RMM
+ */
+#define MBEDTLS_PLATFORM_MEMORY
+
+/* Enable Mbed TLS's built in allocator */
+#define MBEDTLS_MEMORY_BUFFER_ALLOC_C
+
+/* RMM defines its own mbedtls_exit */
+#define MBEDTLS_PLATFORM_EXIT_MACRO mbedtls_exit_panic
+void mbedtls_exit_panic(unsigned int reason);
+
+#define MBEDTLS_PLATFORM_NO_STD_FUNCTIONS
+
+#define MBEDTLS_CIPHER_C
+#define MBEDTLS_PSA_CRYPTO_C
+
+#define MBEDTLS_ECP_C
+#define MBEDTLS_ECP_DP_SECP256R1_ENABLED
+#define MBEDTLS_ECP_RESTARTABLE
+#define MBEDTLS_ECDSA_C
+#define MBEDTLS_ECDSA_DETERMINISTIC
+#define MBEDTLS_ECP_WINDOW_SIZE		(2U)	/* Valid range = [2,7] */
+
+#define MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG
+
+/*
+ * This is enabled in RMM as PSA calls are made within the trust boundary.
+ * Disabling this option causes mbedtls to create a local copy of input buffer
+ * using buffer_alloc_calloc().
+ */
+#define MBEDTLS_PSA_ASSUME_EXCLUSIVE_BUFFERS
+
+#define MBEDTLS_ASN1_PARSE_C
+#define MBEDTLS_ASN1_WRITE_C
+#define MBEDTLS_PK_C
+#define MBEDTLS_PK_WRITE_C
+#define MBEDTLS_PK_PARSE_C
+#define MBEDTLS_OID_C
+
+#define MBEDTLS_X509_USE_C
+#define MBEDTLS_X509_CRT_PARSE_C
+#define MBEDTLS_X509_CREATE_C
+#define MBEDTLS_X509_CRT_WRITE_C
+
+#define MBEDTLS_PLATFORM_SNPRINTF_MACRO snprintf
+
+#define MBEDTLS_BASE64_C
+#define MBEDTLS_BIGNUM_C
+
+#define MBEDTLS_ERROR_C
+
+#define MBEDTLS_HKDF_C
+#define MBEDTLS_HMAC_DRBG_C
+
+#define MBEDTLS_MD_C
+
+#define MBEDTLS_PLATFORM_C
+
+#define MBEDTLS_SHA256_C
+
+#define MBEDTLS_VERSION_C
+
+/*
+ * Prevent the use of 128-bit division which
+ * creates dependency on external libraries.
+ */
+#define MBEDTLS_NO_UDBL_DIVISION
+
+/* Memory buffer allocator option */
+#define MBEDTLS_MEMORY_ALIGN_MULTIPLE	8
+
+/*
+ * Enable acceleration of the SHA-256, SHA-224, SHA-512 and SHA-384
+ * cryptographic hash algorithms with the ARMv8 cryptographic extensions, which
+ * must be available at runtime or else an illegal instruction fault will occur.
+ */
+#ifdef RMM_FPU_USE_AT_REL2
+#define MBEDTLS_SHA256_USE_A64_CRYPTO_ONLY
+#define MBEDTLS_SHA512_USE_A64_CRYPTO_ONLY
+#endif
diff --git a/app/dice_layering/el0_app/src/dice_layering_app.c b/app/dice_layering/el0_app/src/dice_layering_app.c
new file mode 100644
index 0000000..f51f829
--- /dev/null
+++ b/app/dice_layering/el0_app/src/dice_layering_app.c
@@ -0,0 +1,412 @@
+#include <app_common.h>
+#include <arch.h>
+#include <arch_features.h>
+#include <assert.h>
+#include <el0_app_helpers.h>
+#include <errno.h>
+#include <mbedtls/memory_buffer_alloc.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <dice_layering_defs.h>
+#include <psa/crypto.h>
+#include <string.h>
+#include <mbedtls/oid.h>
+#include <mbedtls/asn1.h>
+
+#include <dice_layering_crypto.h>
+
+/* sha256 and sha512 oid are of the same length. */
+#define OID_LEN MBEDTLS_OID_SIZE(MBEDTLS_OID_DIGEST_ALG_SHA256)
+#define CDI_TCI_BUF_LEN (CDI_LEN + MAX_MEASUREMENT_SIZE + OID_LEN + RPV_SIZE)
+#define DICE_LAYERING_HEAP_SIZE (8U * 1024U)
+
+#define MAX_SEED_LEN 64
+
+#define RAK_SALT "RAK"
+#define RAK_SALT_LEN 3
+
+#define RIK_SALT "RIK"
+#define RIK_SALT_LEN 3
+
+struct dice_layering_heap_t {
+	/*
+	 * Variables that are not dynamically allocated, but need to be kept
+	 * local to app instance.
+	 */
+	buffer_alloc_ctx mbedtls_heap_ctx;
+	/*
+	 * During the app initialization, each cpu will re-generate the rmm keyapir,
+	 * which is stored in the psa vault. The handler to that key is cpu dependent.
+	 */
+	psa_key_id_t rmm_key_id;
+	/* The actual heap buffer 
+	 * TODO: dimensionate correctly the buffer according to the HEAP_PAGE_COUNT
+	 *       variable.
+	 */
+	unsigned char mbedtls_heap_buf[DICE_LAYERING_HEAP_SIZE] __aligned(sizeof(unsigned long));
+};
+
+COMPILER_ASSERT((U(offsetof(struct dice_layering_heap_t, mbedtls_heap_buf)) % sizeof(unsigned long)) == 0UL);
+
+/*
+ * True when the first app instance (on CPU0) is initialized.
+ * In this way the other instances will not copy the shared page
+ * content to get the RMM dice init data. Such data are stored in
+ * the static variable therefore defined (dice_data)
+ */
+static bool dice_layering_init_done = false;
+
+/*
+ * Local copy of the rmm cryptographic data.
+ * 
+ * This is needed since the shared page, used for receiving such data,
+ * is also used when the random_app is invoked to get random data. So,
+ * a zero-copy approach would cause the alteration of the input.
+ */
+static struct dice_rmm_data dice_data;
+
+void *mbedtls_app_get_heap(void)
+{
+	return &((struct dice_layering_heap_t *)get_heap_start())->mbedtls_heap_ctx;
+}
+
+/*
+ * This function is used by Mbed TLS as a source of entropy. This means it is
+ * called during RMM operation, to add entropy to the signing process.
+ * See declaration in ext/mbedtls/include/psa/crypto_extra.h.
+ * For details see `MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG` in mbedtls/mbedtls_config.h
+ */
+psa_status_t mbedtls_psa_external_get_random(
+	mbedtls_psa_external_random_context_t *context,
+	uint8_t *output, size_t output_size, size_t *output_length)
+{
+	unsigned long ret;
+
+	assert(output_size <= get_shared_mem_size());
+	ret = el0_app_service_call(APP_SERVICE_RANDOM,
+				   output_size, 0, 0, 0);
+
+	(void)context;
+
+	if (ret != 0U) {
+		return PSA_ERROR_HARDWARE_FAILURE;
+	}
+
+	(void)memcpy((void *)output, get_shared_mem_start(), output_size);
+	*output_length = output_size;
+
+	return PSA_SUCCESS;
+}
+
+static int generate_realm_cdi(struct dice_realm_data *realm_input,
+			      struct crypto_identity *output)
+{
+	uint8_t buf[CDI_TCI_BUF_LEN];
+	size_t buf_len = 0;
+	size_t seed_len = 0;
+	unsigned int rim_len;
+	int ret = -1;
+
+	/* Copy the CDI(RMM) value. */
+	memcpy(buf, dice_data.cdi_rmm, CDI_LEN);
+	/* 
+	 * With a switch-case statement it is more easy extend the algorithm
+	 * list in the future.
+	 */
+	switch (realm_input->algorithm) {
+	case HASH_SHA_256:
+		rim_len = PSA_HASH_LENGTH(PSA_ALG_SHA_256);
+		break;
+	case HASH_SHA_512:
+		rim_len = PSA_HASH_LENGTH(PSA_ALG_SHA_512);
+		break;
+	default:
+		return -1;
+	}
+
+	if (rim_len > MAX_MEASUREMENT_SIZE) {
+		assert(false);
+		return -1;
+	}
+	/* Append the Realm Initial Measurement. */
+	memcpy(&buf[CDI_LEN], realm_input->rim, rim_len);
+	
+	/* Append the hash algorithm OID. */
+	switch (realm_input->algorithm) {
+	case HASH_SHA_256:
+		memcpy(&buf[CDI_LEN + rim_len], MBEDTLS_OID_DIGEST_ALG_SHA256, OID_LEN);
+		break;
+	case HASH_SHA_512:
+		memcpy(&buf[CDI_LEN + rim_len], MBEDTLS_OID_DIGEST_ALG_SHA512, OID_LEN);
+		break;
+	default:
+		return -1;
+	}
+
+	/* Append the Realm Personalization Value. */
+	memcpy(&buf[CDI_LEN + rim_len + OID_LEN], realm_input->rpv, RPV_SIZE);
+	buf_len = CDI_LEN + rim_len + OID_LEN + RPV_SIZE;
+
+	ret = derive_seed(buf, buf_len, output->cdi, &seed_len);
+
+	/* Check if the seed length is the expected one. */
+	if (seed_len != CDI_LEN) {
+		assert(false);
+		return -1;
+	}
+
+	return ret;
+}
+
+/*
+ * The same function generates both the RAK and the RIK.
+ */
+static int generate_key_pairs(const uint8_t *cdi, size_t cdi_len,
+			      struct crypto_identity *output,
+			      psa_key_id_t *rak_id, psa_key_id_t *rik_id)
+{
+	psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;
+	uint8_t seed[CDI_LEN + RAK_SALT_LEN];
+	size_t seed_len = CDI_LEN + RAK_SALT_LEN;
+	size_t exported_len;
+
+	/*
+	 * RAK SECTION
+	 */
+	memcpy(seed, cdi, cdi_len);
+	memcpy(&seed[cdi_len], RAK_SALT, RAK_SALT_LEN);
+	
+	/* Generate the key */
+	status = derive_keypair_deterministic(seed, seed_len, rak_id);
+	if (status != PSA_SUCCESS) goto end;
+
+	/* Extract the private key */
+	status = psa_export_key(*rak_id, output->rak, sizeof(output->rak), &exported_len);
+	if (status != PSA_SUCCESS) goto end;
+
+	/*
+	 * RIK SECTION
+	 */
+	memcpy(&seed[cdi_len], RIK_SALT, RIK_SALT_LEN);
+	seed_len = CDI_LEN + RIK_SALT_LEN;
+
+	/* Generate the key */
+	status = derive_keypair_deterministic(seed, seed_len, rik_id);
+	if (status != PSA_SUCCESS) goto end;
+
+	/* Extract the private key */
+	status = psa_export_key(*rik_id, output->rik, sizeof(output->rik), &exported_len);
+	if (status != PSA_SUCCESS) goto end;
+
+end:
+	return status;
+}
+
+/* ====================
+ * APPLICATION HANDLERS
+ * ====================
+ */
+
+/*
+ * Generate the Realm keypair and validate it against the certificate.
+ */
+static int dice_layering_init_data()
+{
+	int ret = 0;
+	psa_status_t psa_status;
+
+	struct dice_layering_heap_t *heap = (struct dice_layering_heap_t *)get_heap_start();
+
+	/*
+	 * Some init operations work on variables available to all the app instances.
+	 * Such operations must be performed only once, at the first initialization.
+	 */
+	if (!dice_layering_init_done) {
+		memcpy(&dice_data, get_shared_mem_start(), sizeof(struct dice_rmm_data));
+		/*
+		 * Once the content of the shared memory has been copied, clean
+		 * that memory area to avoid that the other applications may
+		 * access the dice rmm data.
+		 */
+		memset(get_shared_mem_start(), 0, get_shared_mem_size());
+	}
+
+	/* Initialize the mbedtls heap and the psa module */
+	mbedtls_memory_buffer_alloc_init(heap->mbedtls_heap_buf,
+					 sizeof(heap->mbedtls_heap_buf));
+	psa_status = psa_crypto_init();
+	if (psa_status != PSA_SUCCESS)
+		return (unsigned long)(psa_status); /*fix -EINVAL overflow error*/
+
+	/*
+	 * Derive the Realm keypair and verify its validity against the
+	 * certificate chain
+	 */
+	psa_status = derive_keypair_deterministic(dice_data.cdi_rmm, 32,
+						  &heap->rmm_key_id);
+	if(psa_status != PSA_SUCCESS) return psa_status;
+
+	ret = verify_derived_key_vs_cert(heap->rmm_key_id, dice_data.cert_rmm,
+					 dice_data.cert_rmm_len);
+	if (ret != 0) return ret;
+
+	ret = verify_certificate_chain(dice_data.cert_rmm, dice_data.cert_rmm_len,
+				       dice_data.cert_tfa, dice_data.cert_tfa_len);
+	if (ret != 0) return ret;
+
+	dice_layering_init_done = true;
+
+	return ret;
+}
+
+/*
+ * Get the Realm measurements data, along with the RPV, and generate the
+ * dice derived cryptographic data. The output must be returned to the
+ * RMM through the shared memory.
+ */
+static int dice_layering_init_realm_crypto()
+{
+	int ret = -1;
+	struct dice_realm_data dice_realm;
+	struct crypto_identity output = {0};
+	psa_key_id_t rak_id, rik_id;
+
+	struct dice_layering_heap_t *heap = (struct dice_layering_heap_t *)get_heap_start();
+
+	/*
+	 * Copy the measurement values from the shared page, then clean the memory
+	 * since the same area will be used for other stuff.
+	 */
+	memcpy(&dice_realm, get_shared_mem_start(), sizeof(struct dice_realm_data));
+	memset(get_shared_mem_start(), 0, get_shared_mem_size());
+
+	/*
+	 * Use the input data to compute the TCI.
+	 */
+	ret = generate_realm_cdi(&dice_realm, &output);
+	if (ret != 0) {
+		goto cleanup;
+	}
+	
+	/*
+	 * Once the Realm's CDI has been generated, derive the RAK and the RIK.
+	 */
+	ret = generate_key_pairs(output.cdi, sizeof(output.cdi), &output,
+				 &rak_id, &rik_id);
+	if (ret != 0) {
+		goto cleanup;
+	}
+
+	/*
+	 * Finally generate the public key certificates for both the RIK and RAK
+	 */
+	ret = generate_dice_certificate(rak_id, heap->rmm_key_id,
+					"CN=Realm,O=CCA_Machine",
+					"CN=RMM,O=CCA_Machine",
+					output.rak_cert, sizeof(output.rak_cert),
+					&output.rak_cert_len);
+	if (ret != 0) {
+		goto cleanup;
+	}
+
+	ret = generate_dice_certificate(rik_id, heap->rmm_key_id,
+					"CN=Realm,O=CCA_Machine",
+					"CN=RMM,O=CCA_Machine",
+					output.rik_cert, sizeof(output.rik_cert),
+					&output.rik_cert_len);
+	if (ret != 0) {
+		goto cleanup;
+	}
+	
+	/* Copy the generated data back to the RMM through the shared page. */
+	memcpy(get_shared_mem_start(), &output, sizeof(struct crypto_identity));
+
+cleanup:
+	psa_destroy_key(rak_id);
+	psa_destroy_key(rik_id);
+	return ret;
+}
+
+static int dice_layering_sign_data()
+{
+	int ret = -1;
+	struct sign_operation_input input;
+	struct sign_operation_output output;
+
+	memcpy(&input, get_shared_mem_start(), sizeof(struct sign_operation_input));
+	memset(get_shared_mem_start(), 0, get_shared_mem_size());
+
+	ret = sign_payload_deterministic_ecdsa(input.key, input.key_len,
+					       input.payload, input.payload_len,
+					       output.signature, sizeof(output.signature),
+					       &output.signature_len);
+
+	memcpy(get_shared_mem_start(), &output,sizeof(struct sign_operation_output));
+	return ret;
+}
+
+static int dice_layering_output_certs()
+{
+	struct cert_chain *out = (struct cert_chain *)get_shared_mem_start();
+	if (out == NULL) return -1;
+
+	memcpy(out->cert_rmm, dice_data.cert_rmm, dice_data.cert_rmm_len);
+	out->cert_rmm_len = dice_data.cert_rmm_len;
+	
+	memcpy(out->cert_tfa, dice_data.cert_tfa, dice_data.cert_tfa_len);
+	out->cert_tfa_len = dice_data.cert_tfa_len;
+
+	return 0;
+}
+
+unsigned long el0_app_entry_func(
+	unsigned long func_id,
+	unsigned long arg_0,
+	unsigned long arg_1,
+	unsigned long arg_2,
+	unsigned long arg_3)
+{
+	(void)arg_0;
+	(void)arg_1;
+	(void)arg_2;
+	(void)arg_3;
+
+	switch (func_id) {
+	case DICE_LAYERING_APP_FUNC_INIT:
+		/*
+		 * init_function
+		 * consider if passing the RMM CDI at this step since it
+		 * does not change once generated.
+		 *
+		 * Needed inputs:
+		 * - the RMM CDI
+		 * - the certificate chain
+		 */
+		return dice_layering_init_data();
+		break;
+	case DICE_LAYERING_APP_FUNC_GEN_REALM_DATA:
+		/*
+		 * Given a RIM and a CDI(n-1) (?), generate
+		 * - a Deterministic ECDSA keypair
+		 * - a certificate for the pubkey  
+		 */
+		return dice_layering_init_realm_crypto();
+		break;
+	case DICE_LAYERING_APP_FUNC_SIGN_OPERATION:
+		/*
+		 * Perform a cryptographic operation on behalf of the
+		 * Realm which is requesting such operation.
+		 */
+		return dice_layering_sign_data();
+		break;
+	case DICE_LAYERING_APP_FUNC_GET_CERT:
+		return dice_layering_output_certs();
+		break;
+	default:
+		assert(false);
+		return 0;
+	}
+
+	return 0;
+}
