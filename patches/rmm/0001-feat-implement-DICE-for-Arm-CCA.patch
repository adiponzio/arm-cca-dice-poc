+#include <dice_layering_crypto.h>
+
+#include <mbedtls/pk.h>
+#include <mbedtls/x509_crt.h>
+#include <mbedtls/x509.h>
+#include <string.h>
+#include <debug.h>
+
+#define MAX_EC_PUB_KEY_SIZE 133
+
+static int dummy_rng_wrapper(void *ctx, unsigned char *buf, size_t len)
+{
+    (void)ctx; /* Unused */
+
+    if (buf != NULL && len > 0) {
+        /* Fill with zeros to avoid uninitialized memory access just in case */
+        memset(buf, 0, len);
+    }
+
+    return PSA_SUCCESS;
+}
+
+int derive_keypair_deterministic(void* seed, size_t seed_len,
+				 psa_key_id_t* key_id)
+{
+	/*
+	 * 1. Import the seed in the vault
+	 */
+	psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;
+	psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
+	psa_key_derivation_operation_t deriv_op = PSA_KEY_DERIVATION_OPERATION_INIT;
+
+	psa_key_id_t seed_id = PSA_KEY_ID_NULL;
+
+	psa_set_key_type(&attributes, PSA_KEY_TYPE_DERIVE);
+	psa_set_key_usage_flags(&attributes, PSA_KEY_USAGE_DERIVE);
+	psa_set_key_algorithm(&attributes, PSA_ALG_HKDF(PSA_ALG_SHA_256));
+
+	status = psa_import_key(&attributes, seed, seed_len, &seed_id);
+	if (status != PSA_SUCCESS) return status;
+
+	/*
+	 * 2. Derive the keypair
+	 */
+	attributes = psa_key_attributes_init();
+
+	status = psa_key_derivation_setup(&deriv_op,
+					  PSA_ALG_HKDF(PSA_ALG_SHA_256));
+	if (status != PSA_SUCCESS) goto end;
+
+	/*
+	 * Provide NULL salt and info since they are not needed
+	 */
+	status = psa_key_derivation_input_bytes(&deriv_op,
+						PSA_KEY_DERIVATION_INPUT_SALT,
+						NULL, 0);
+	if (status != PSA_SUCCESS) goto end;
+
+	status = psa_key_derivation_input_key(&deriv_op,
+					      PSA_KEY_DERIVATION_INPUT_SECRET,
+					      seed_id);
+	if (status != PSA_SUCCESS) goto end;
+
+	status = psa_key_derivation_input_bytes(&deriv_op,
+						PSA_KEY_DERIVATION_INPUT_INFO,
+						NULL, 0);
+	if (status != PSA_SUCCESS) goto end;
+
+	/* Set the curve and the key dimension */
+	psa_set_key_type(&attributes,
+			 PSA_KEY_TYPE_ECC_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1));
+
+	psa_set_key_bits(&attributes, 256);
+
+	/* Set key permissions */
+	psa_set_key_usage_flags(&attributes,
+				PSA_KEY_USAGE_SIGN_HASH | PSA_KEY_USAGE_EXPORT);
+	psa_set_key_algorithm(&attributes,
+			      PSA_ALG_DETERMINISTIC_ECDSA(PSA_ALG_SHA_256));
+
+	/* Generate the key */
+	status = psa_key_derivation_output_key(&attributes, &deriv_op, key_id);
+end:
+	psa_key_derivation_abort(&deriv_op);
+	psa_destroy_key(seed_id);
+
+	return status;
+}
+
+int verify_derived_key_vs_cert(psa_key_id_t key_id,
+                               const uint8_t *cert_buf, size_t cert_buf_len)
+{
+        int ret = -1;
+        psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;
+        mbedtls_x509_crt cert;
+        psa_key_attributes_t cert_key_attrs = PSA_KEY_ATTRIBUTES_INIT;
+        psa_key_id_t cert_psa_key_id = PSA_KEY_ID_NULL;
+
+        uint8_t deriv_pub[PSA_EXPORT_PUBLIC_KEY_MAX_SIZE];
+        size_t deriv_pub_len  = 0;
+        uint8_t cert_pub[PSA_EXPORT_PUBLIC_KEY_MAX_SIZE];
+        size_t cert_pub_len   = 0;
+
+        mbedtls_x509_crt_init(&cert);
+
+        ret = mbedtls_x509_crt_parse_der_nocopy(&cert, cert_buf, cert_buf_len);
+        if (ret != 0) {
+                ERROR("Failed to parse DER certificate: -0x%04x\n", -ret);
+                goto cleanup;
+        }
+
+        if (!mbedtls_pk_can_do(&cert.pk, MBEDTLS_PK_ECDSA)) {
+                ERROR("Certificate public key is not ECDSA.\n");
+                ret = MBEDTLS_ERR_PK_KEY_INVALID_FORMAT;
+                goto cleanup;
+        }
+
+        status = psa_export_public_key(key_id,
+                                       deriv_pub, sizeof(deriv_pub),
+                                       &deriv_pub_len);
+        if (status != PSA_SUCCESS) {
+                ERROR("psa_export_public_key() failed: %d\n", (int)status);
+                ret = MBEDTLS_ERR_PK_BAD_INPUT_DATA;
+                goto cleanup;
+        }
+
+        ret = mbedtls_pk_get_psa_attributes(&cert.pk,
+                                            PSA_KEY_USAGE_VERIFY_HASH,
+                                            &cert_key_attrs);
+        if (ret != 0) {
+                ERROR("mbedtls_pk_get_psa_attributes() failed: -0x%04x\n", -ret);
+                goto cleanup;
+        }
+
+	psa_set_key_usage_flags(&cert_key_attrs,
+                                psa_get_key_usage_flags(&cert_key_attrs) |
+                                PSA_KEY_USAGE_EXPORT);
+
+        ret = mbedtls_pk_import_into_psa(&cert.pk,
+                                         &cert_key_attrs,
+                                         &cert_psa_key_id);
+        if (ret != 0) {
+                ERROR("mbedtls_pk_import_into_psa() failed: -0x%04x\n", -ret);
+                goto cleanup;
+        }
+
+        status = psa_export_public_key(cert_psa_key_id,
+                                       cert_pub, sizeof(cert_pub),
+                                       &cert_pub_len);
+        if (status != PSA_SUCCESS) {
+                ERROR("psa_export_public_key() for cert key failed: %d\n",
+                      (int)status);
+                ret = MBEDTLS_ERR_PK_BAD_INPUT_DATA;
+                goto cleanup;
+        }
+
+        if (deriv_pub_len != cert_pub_len) {
+                ERROR("Public key length mismatch: derived=%zu cert=%zu\n",
+                      deriv_pub_len, cert_pub_len);
+                ret = MBEDTLS_ERR_PK_BAD_INPUT_DATA;
+                goto cleanup;
+        }
+
+        if (memcmp(deriv_pub, cert_pub, deriv_pub_len) != 0) {
+                ERROR("Derived key does not match the certificate public key.\n");
+                ret = MBEDTLS_ERR_PK_BAD_INPUT_DATA;
+                goto cleanup;
+        }
+
+        ret = 0;
+
+cleanup:
+        if (cert_psa_key_id != PSA_KEY_ID_NULL) {
+                psa_status_t destroy_status = psa_destroy_key(cert_psa_key_id);
+                if (destroy_status != PSA_SUCCESS) {
+                        ERROR("psa_destroy_key() failed: %d\n",
+                              (int)destroy_status);
+                        if (ret == 0) {
+                                ret = MBEDTLS_ERR_PK_BAD_INPUT_DATA;
+                        }
+                }
+        }
+
+        psa_reset_key_attributes(&cert_key_attrs);
+        mbedtls_x509_crt_free(&cert);
+        return ret;
+}
+
+int verify_certificate_chain(const uint8_t *child_der, size_t child_len,
+                             const uint8_t *parent_der, size_t parent_len)
+{
+	int ret = -1;
+	uint32_t flags = 0;
+	mbedtls_x509_crt child_crt;
+	mbedtls_x509_crt parent_crt;
+
+	/* Initialize both contexts */
+	mbedtls_x509_crt_init(&child_crt);
+	mbedtls_x509_crt_init(&parent_crt);
+
+	/* 
+	 * 1. Parse the child certificate 
+	 * Using nocopy assumes the DER buffers remain mapped in memory 
+	 * for the duration of this function.
+	 */
+	ret = mbedtls_x509_crt_parse_der_nocopy(&child_crt, child_der, child_len);
+	if (ret != 0) {
+		ERROR("Failed to parse child cert: -0x%04x\n", -ret);
+		goto cleanup;
+	}
+
+	/* 2. Parse the parent (issuer) certificate */
+	ret = mbedtls_x509_crt_parse_der_nocopy(&parent_crt, parent_der, parent_len);
+	if (ret != 0) {
+		ERROR("Failed to parse parent cert: -0x%04x\n", -ret);
+		goto cleanup;
+	}
+
+	/* 
+	 * 3. Verify the child against the parent
+	 * 
+	 * Parameters:
+	 *   &child_crt : The certificate to verify
+	 *   &parent_crt: The trusted CA chain
+	 *   NULL       : Certificate Revocation List (CRL) - not used here
+	 *   NULL       : Expected Common Name (CN) - skips domain validation
+	 *   &flags     : Output flags detailing any verification errors
+	 *   NULL       : Custom verification profile (NULL uses the default)
+	 *   NULL       : Custom verification callback
+	 */
+	ret = mbedtls_x509_crt_verify(&child_crt, &parent_crt, NULL, NULL, &flags, NULL, NULL);
+
+	if (ret != 0) {
+		ERROR("Certificate verification failed: -0x%04x\n", -ret);
+
+		/* If validation failed, decode the flags to find out why */
+		if (flags != 0) {
+			char vrfy_buf[512];
+			/* This translates the bitmask flags into human-readable text */
+			mbedtls_x509_crt_verify_info(vrfy_buf, sizeof(vrfy_buf), "  ! ", flags);
+			ERROR("Verification breakdown:\n%s\n", vrfy_buf);
+		}
+		goto cleanup;
+	}
+
+	INFO("Success: Child certificate is signed by the parent and is valid.\n");
+	ret = 0;
+
+cleanup:
+	/* Free the internal structures (does not free the nocopy DER buffers) */
+	mbedtls_x509_crt_free(&child_crt);
+	mbedtls_x509_crt_free(&parent_crt);
+	return ret;
+}
+
+/*
+ * Derive a value by the mean of a pseudo random function.
+ * As a first implementation, use directly HKDF.
+ * The derived value is either exported to the caller
+ */
+int derive_seed(const void* input, size_t input_len, void* output, size_t* output_len)
+{
+	psa_status_t status;
+	psa_key_derivation_operation_t deriv_op = PSA_KEY_DERIVATION_OPERATION_INIT;
+
+	status = psa_key_derivation_setup(&deriv_op, PSA_ALG_HKDF(PSA_ALG_SHA_256));
+	if (status != PSA_SUCCESS)
+		return status;
+
+	/*
+	 * Provide NULL salt and info since they are not needed.
+	 */
+	status = psa_key_derivation_input_bytes(&deriv_op, PSA_KEY_DERIVATION_INPUT_SALT,
+						NULL, 0);
+	if (status != PSA_SUCCESS) goto end;
+
+	status = psa_key_derivation_input_bytes(&deriv_op, PSA_KEY_DERIVATION_INPUT_SECRET,
+						input, input_len);
+	if (status != PSA_SUCCESS) goto end;
+
+	status = psa_key_derivation_input_bytes(&deriv_op, PSA_KEY_DERIVATION_INPUT_INFO,
+						NULL, 0);
+	if (status != PSA_SUCCESS) goto end;
+
+	/*
+	 * Since SHA256 is hardcoded as hash algorithm, hardcode the out_len
+	 * to 32bytes
+	 */
+	*output_len = 32;
+	status = psa_key_derivation_output_bytes(&deriv_op, output, *output_len);
+end:
+	psa_key_derivation_abort(&deriv_op);
+	return status;
+}
+
+int generate_dice_certificate(psa_key_id_t subject_key_id,
+			      psa_key_id_t issuer_key_id,
+			      const char *subject_name,
+			      const char *issuer_name,
+			      uint8_t *out_der, size_t max_out_size,
+			      size_t *cert_len)
+{
+	int ret;
+	mbedtls_pk_context subject_pk;
+	mbedtls_pk_context issuer_pk;
+	mbedtls_x509write_cert crt;
+	mbedtls_mpi serial;
+
+	/* Standard RNG context needed by the X.509 module for internal formatting */
+	//mbedtls_ctr_drbg_context ctr_drbg;
+	//mbedtls_entropy_context entropy;
+
+	mbedtls_pk_init(&subject_pk);
+	mbedtls_pk_init(&issuer_pk);
+	mbedtls_x509write_crt_init(&crt);
+	mbedtls_mpi_init(&serial);
+	//mbedtls_ctr_drbg_init(&ctr_drbg);
+	//mbedtls_entropy_init(&entropy);
+
+	/* Seed the RNG (X.509 needs this, even though PSA handles the actual signing RNG) */
+	//ret = mbedtls_ctr_drbg_seed(&ctr_drbg, mbedtls_entropy_func, &entropy,
+	//                            (const unsigned char *)"DICE_CERT_AAA", 13);
+	//if (ret != 0) goto cleanup;
+
+	/* Wrap subject key in pk context */
+	ret = mbedtls_pk_setup_opaque(&subject_pk, subject_key_id);
+	if (ret != 0) {
+		goto cleanup;
+	}
+
+	ret = mbedtls_pk_setup_opaque(&issuer_pk, issuer_key_id);
+	if (ret != 0) {
+		goto cleanup;
+	}
+
+	mbedtls_x509write_crt_set_version(&crt, MBEDTLS_X509_CRT_VERSION_3);
+	mbedtls_x509write_crt_set_md_alg(&crt, MBEDTLS_MD_SHA256);
+
+	mbedtls_x509write_crt_set_subject_key(&crt, &subject_pk);
+	mbedtls_x509write_crt_set_issuer_key(&crt, &issuer_pk);
+
+
+	/* Set standard Distinguished Names (DN) */
+	ret = mbedtls_x509write_crt_set_subject_name(&crt, subject_name);
+	if (ret != 0) goto cleanup;
+
+	ret = mbedtls_x509write_crt_set_issuer_name(&crt, issuer_name);
+	if (ret != 0) goto cleanup;
+
+	ret = mbedtls_x509write_crt_set_validity(&crt, "20240101000000", "20991231235959");
+	if (ret != 0) goto cleanup;
+
+	mbedtls_mpi_lset(&serial, 1);
+	ret = mbedtls_x509write_crt_set_serial(&crt, &serial);
+	if (ret != 0) goto cleanup;
+
+	/* Constraints:
+	 *	- is_ca = 0
+	 *	- max_path_len = 0 (no certificate can be signed )
+	 */
+	ret = mbedtls_x509write_crt_set_basic_constraints(&crt, 0, 0);
+	if (ret != 0) goto cleanup;
+
+	ret = mbedtls_x509write_crt_set_key_usage(&crt, MBEDTLS_X509_KU_KEY_CERT_SIGN);
+	if (ret != 0) goto cleanup;
+
+	/* clean the memory for the certificate */
+	memset(out_der, 0, max_out_size);
+
+	ret = mbedtls_x509write_crt_der(&crt, out_der, max_out_size,
+	                                dummy_rng_wrapper, NULL);
+	if (ret > 0) {
+		*cert_len = ret;
+		/*
+		 * Since the function writes the certificate at the end
+		 * of the buffer, move it to the beginning.
+		 */
+		memmove(out_der, out_der + max_out_size - ret, ret);
+		ret = 0;
+	} else {
+		/*
+		 * ret = 0 indicates a failure in the mbedtls_x509write_crt_der
+		 * function. So, set the variable to any value different
+		 * from 0 to ensure a proper return code.
+		 */
+		ret = -1;
+	}
+
+cleanup:
+	/* Free all memory buffers to prevent leaks */
+	mbedtls_pk_free(&subject_pk);
+	mbedtls_pk_free(&issuer_pk);
+	mbedtls_x509write_crt_free(&crt);
+	mbedtls_mpi_free(&serial);
+	//mbedtls_ctr_drbg_free(&ctr_drbg);
+	//mbedtls_entropy_free(&entropy);
+
+	return (ret == 0) ? PSA_SUCCESS : PSA_ERROR_GENERIC_ERROR;
+}
+
+/*
+ * Perform the signature of the given payload.
+ *
+ * The function assumes that the input is already hashed.
+ */
+int sign_payload_deterministic_ecdsa(const uint8_t *priv_key, size_t priv_key_len,
+                                     const uint8_t *payload_hash, size_t hash_len,
+                                     uint8_t *signature, size_t signature_size,
+                                     size_t *signature_len)
+{
+	int ret = -1;
+	psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;
+	psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
+	psa_key_id_t key_id = PSA_KEY_ID_NULL;
+
+	/* Set key attributes */
+	psa_set_key_type(&attributes, PSA_KEY_TYPE_ECC_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1));
+	psa_set_key_bits(&attributes, 256);
+	psa_set_key_usage_flags(&attributes, PSA_KEY_USAGE_SIGN_HASH);
+	psa_set_key_algorithm(&attributes, PSA_ALG_DETERMINISTIC_ECDSA(PSA_ALG_SHA_256));
+
+	status = psa_import_key(&attributes, priv_key, priv_key_len, &key_id);
+	if (status != PSA_SUCCESS) {
+		ERROR("psa_import_key() failed: %d\n", (int)status);
+		ret = -1;
+		goto cleanup;
+	}
+
+	status = psa_sign_hash(key_id,
+			       PSA_ALG_DETERMINISTIC_ECDSA(PSA_ALG_SHA_256),
+			       payload_hash, hash_len,
+			       signature, signature_size, signature_len);
+	if (status != PSA_SUCCESS) {
+		ERROR("psa_sign_hash() failed: %d\n", (int)status);
+		ret = -1;
+		goto cleanup;
+	}
+
+	ret = 0;
+cleanup:
+	psa_status_t destroy_status = psa_destroy_key(key_id);
+        if (destroy_status != PSA_SUCCESS) {
+		ERROR("psa_destroy_key() failed: %d\n", (int)destroy_status);
+		if (ret == 0) ret = -1;
+        }
+	return (ret == 0) ? PSA_SUCCESS : PSA_ERROR_GENERIC_ERROR;
+}
