+	struct crypto_identity *dice_id;
+	size_t actual_out_size = 0UL;
+	int crypto_ret;
+
+	assert(rec != NULL);
+
+	/* RSI calls can only be issued by Plane 0 */
+	plane = rec_plane_0(rec);
+	assert(rec_is_plane_0_active(rec));
+
+	op_id = plane->regs[1];
+	shared_ipa = plane->regs[2];
+	input_len = plane->regs[3];
+	out_size = plane->regs[4];
+
+	res->action = UPDATE_REC_RETURN_TO_REALM;
+
+	if (!GRANULE_ALIGNED(shared_ipa) || !addr_in_rec_par(rec, shared_ipa)) {
+		res->smc_res.x[0] = RSI_ERROR_INPUT;
+		return;
+	}
+
+	if (!realm_mem_lock_map(rec, shared_ipa, &shared_va, &llt, res)) {
+		/* In case of failure res is updated */
+		return;
+	}
+
+	assert((shared_va != NULL) && (llt != NULL));
+
+	if (op_id == RSI_DICE_OP_CERT_CHAIN) {
+		const struct dice_rmm_data *parents = rmm_el3_ifc_get_dice_data();
+		struct cert_chain *chain = shared_va;
+
+		/* One immutable machine-wide copy; no RD/AUX mapping is needed. */
+		if ((parents == NULL) || (out_size < sizeof(*chain)) ||
+		    (parents->cert_dice_rak_len == 0U) ||
+		    (parents->cert_dice_rak_len > sizeof(chain->cert_dice_rak)) ||
+		    (parents->cert_tfa_len == 0U) ||
+		    (parents->cert_tfa_len > sizeof(chain->cert_tfa))) {
+			res->smc_res.x[0] = RSI_ERROR_INPUT;
+			goto out_shared;
+		}
+
+		/* Export only public certificates and zero all unused ABI padding. */
+		(void)memset(chain, 0, sizeof(*chain));
+		(void)memcpy(chain->cert_dice_rak, parents->cert_dice_rak,
+			     parents->cert_dice_rak_len);
+		chain->cert_dice_rak_len = parents->cert_dice_rak_len;
+		(void)memcpy(chain->cert_tfa, parents->cert_tfa,
+			     parents->cert_tfa_len);
+		chain->cert_tfa_len = parents->cert_tfa_len;
+		res->smc_res.x[0] = RSI_SUCCESS;
+		res->smc_res.x[1] = sizeof(*chain);
+		goto out_shared;
+	}
+
+	/*
+	 * Map RD and RD_AUX granules. The Realm's DICE identity is initialized
+	 * once at RMI_REALM_ACTIVATE and remains read-only while RECs run.
+	 */
+	rd = buffer_granule_map(rec->realm_info.g_rd, SLOT_RD);
+	assert(rd != NULL);
+
+	rd_aux = buffer_rd_aux_granules_map(&rd->aux_granules[0], rd->num_rd_aux);
+	assert(rd_aux != NULL);
+
+	dice_id = &rd_aux->crypto_data;
+
+	switch (op_id) {
+	case RSI_DICE_OP_SIGN_DSRAK:
+	case RSI_DICE_OP_SIGN_DSRIK: {
+		unsigned long app_op;
+
+		if ((input_len == 0UL) || (input_len > MAX_DICE_PAYLOAD_LEN) ||
+		    (out_size == 0UL) || (out_size > GRANULE_SIZE)) {
+			res->smc_res.x[0] = RSI_ERROR_INPUT;
+			goto out_unmap;
+		}
+
+		app_op = (op_id == RSI_DICE_OP_SIGN_DSRAK) ?
+			 DICE_LAYERING_APP_FUNC_ID_SIGN_DSRAK :
+			 DICE_LAYERING_APP_FUNC_ID_SIGN_DSRIK;
+
+		crypto_ret = dice_layering_app_sign_operation(
+			app_op, dice_id,
+			(uint8_t *)shared_va, input_len,
+			(uint8_t *)shared_va, out_size, &actual_out_size);
+		if (crypto_ret != 0) {
+			res->smc_res.x[0] = RSI_ERROR_INPUT;
+			goto out_unmap;
+		}
+
+		res->smc_res.x[0] = RSI_SUCCESS;
+		res->smc_res.x[1] = actual_out_size;
+		break;
+	}
+
+	case RSI_DICE_OP_CERT_DSRAK:
+	case RSI_DICE_OP_CERT_DSRIK: {
+		const uint8_t *cert_ptr;
+		size_t cert_len;
+
+		if (op_id == RSI_DICE_OP_CERT_DSRAK) {
+			cert_ptr = dice_id->cert_dsrak;
+			cert_len = dice_id->cert_dsrak_len;
+		} else {
+			cert_ptr = dice_id->cert_dsrik;
+			cert_len = dice_id->cert_dsrik_len;
+		}
+
+		if ((cert_len == 0UL) || (out_size < cert_len) ||
+		    (cert_len > GRANULE_SIZE)) {
+			res->smc_res.x[0] = RSI_ERROR_INPUT;
+			goto out_unmap;
+		}
+
+		(void)memcpy(shared_va, cert_ptr, cert_len);
+		res->smc_res.x[0] = RSI_SUCCESS;
+		res->smc_res.x[1] = cert_len;
+		break;
+	}
+
+	default:
+		res->smc_res.x[0] = RSI_ERROR_INPUT;
+		break;
+	}
+
+out_unmap:
+	buffer_rd_aux_granules_unmap(rd_aux, rd->num_rd_aux);
+	buffer_unmap(rd);
+out_shared:
+	buffer_unmap(shared_va);
+	granule_unlock(llt);
+}
-- 
