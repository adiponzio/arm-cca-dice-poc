+void handle_rsi_dice_crypto(struct rec *rec, struct rsi_result *res)
+{
+	struct rec_plane *plane;
+	unsigned long op_id;
+	unsigned long shared_ipa;
+	unsigned long input_len;
+	unsigned long out_size;
+	struct granule *llt = NULL;
+	void *shared_va = NULL;
+	struct rd *rd = NULL;
