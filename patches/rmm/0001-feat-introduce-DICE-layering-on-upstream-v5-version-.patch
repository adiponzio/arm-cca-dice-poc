--- /dev/null
+++ b/app/dice_layering/rmm_stub/include/dice_layering_defs.h
@@ -0,0 +1,58 @@
+/*
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#ifndef DICE_LAYERING_DEFS_H
+#define DICE_LAYERING_DEFS_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <utils_def.h>
+
+#define DICE_LAYERING_APP_FUNC_ID_INIT			0x1U
+#define DICE_LAYERING_APP_FUNC_ID_REALM_INIT		0x2U
+#define DICE_LAYERING_APP_FUNC_ID_SIGN_DSRAK		0x3U
+#define DICE_LAYERING_APP_FUNC_ID_SIGN_DSRIK		0x4U
+
+#define DICE_LAYERING_APP_FUNC_ID_GET_CERT		0x5U
+
+#define CDI_LEN			U(32)
+#define TCI_LEN			U(32)
+#define SEC_KEY_LEN		U(32)
+#define SEED_LEN		(CDI_LEN + TCI_LEN)
+#define CERT_MAX_LEN		U(1024)
+
+/*
+ * Data structure with the DICE layering objects passed from TF-A BL31 to RMM.
+ * Must match struct dice_rmm_data in lib/rmm_el3_ifc/include/rmm_el3_ifc.h.
+ */
+struct dice_manifest_data {
+	uint8_t cdi_rmm[CDI_LEN];
+	uint8_t cert_dice_rak[CERT_MAX_LEN];
+	size_t cert_dice_rak_len;
+	uint8_t cert_tfa[CERT_MAX_LEN];
+	size_t cert_tfa_len;
+};
+
+/* Userspace export layout only; persistent certificates live in the manifest. */
+struct cert_chain {
+	uint8_t cert_dice_rak[CERT_MAX_LEN];
+	size_t cert_dice_rak_len;
+	uint8_t cert_tfa[CERT_MAX_LEN];
+	size_t cert_tfa_len;
+};
+
+/*
+ * Per-Realm cryptographic identity stored inside struct rd_aux.
+ */
+struct crypto_identity {
+	uint8_t cdi[CDI_LEN];
+	uint8_t dsrak[SEC_KEY_LEN];
+	uint8_t cert_dsrak[CERT_MAX_LEN];
+	size_t cert_dsrak_len;
+	uint8_t dsrik[SEC_KEY_LEN];
+	uint8_t cert_dsrik[CERT_MAX_LEN];
+	size_t cert_dsrik_len;
+};
+
+#endif /* DICE_LAYERING_DEFS_H */
diff --git a/app/dice_layering/rmm_stub/src/app_support/dice_layering_app.c b/app/dice_layering/rmm_stub/src/app_support/dice_layering_app.c
new file mode 100644
index 00000000..f3e3a82c
--- /dev/null
+++ b/app/dice_layering/rmm_stub/src/app_support/dice_layering_app.c
@@ -0,0 +1,247 @@
+/*
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <app_common.h>
+#include <assert.h>
+#include <cpuid.h>
+#include <debug.h>
+#include <dice_layering_app.h>
+#include <dice_layering_defs.h>
+#include <errno.h>
+#include <limits.h>
+#include <rmm_el3_ifc.h>
+#include <simd.h>
+#include <string.h>
+
+#define DICE_LAYERING_APP_PAGE_COUNT	11U
+
+static unsigned char rmm_dice_layering_app_pages
+	[MAX_CPUS][DICE_LAYERING_APP_PAGE_COUNT][GRANULE_SIZE] __aligned(GRANULE_SIZE);
+static struct app_data_cfg rmm_dice_layering_app_datas[MAX_CPUS] __aligned(GRANULE_SIZE);
+static bool dice_layering_app_init_done[MAX_CPUS];
+
+COMPILER_ASSERT(sizeof(struct dice_rmm_data) ==
+		sizeof(struct dice_manifest_data));
+COMPILER_ASSERT(sizeof(struct dice_rmm_data) <= GRANULE_SIZE);
+
+static int dice_layering_app_init_data(
+	struct app_data_cfg *app_data,
+	uintptr_t granule_pas[],
+	size_t granule_pa_count,
+	void *granule_va_start)
+{
+	assert(!dice_layering_app_init_done[my_cpuid()]);
+
+	return app_new_instance(app_data,
+				DICE_LAYERING_APP_ID,
+				granule_pas,
+				granule_pa_count,
+				granule_va_start,
+				APP_INSTANCE_FLAG_PERSISTENT);
+}
+
+static int dice_layering_app_init_crypto(struct app_data_cfg *app_data)
+{
+	unsigned long ret;
+	const struct dice_rmm_data *dice_data;
+
+	assert(!dice_layering_app_init_done[my_cpuid()]);
+
+	dice_data = rmm_el3_ifc_get_dice_data();
+	if (dice_data == NULL) {
+		ERROR("DICE: No DICE data found in boot manifest\n");
+		return -EINVAL;
+	}
+
+	app_map_shared_page(app_data);
+	assert(app_data->el2_shared_page != NULL);
+	(void)memcpy(app_data->el2_shared_page, dice_data,
+		     sizeof(struct dice_rmm_data));
+	app_unmap_shared_page(app_data);
+
+	SIMD_FPU_ALLOW(
+		ret = app_run(app_data, DICE_LAYERING_APP_FUNC_ID_INIT,
+			      0UL, 0UL, 0UL, 0UL));
+
+	assert(app_data->exit_flag != APP_EXIT_SVC_YIELD_FLAG);
+
+	if (ret > (unsigned long)INT_MAX) {
+		return -EINVAL;
+	}
+	return (int)ret;
+}
+
+void dice_layering_app_get_bss(uintptr_t *bss_pa, size_t *bss_size);
+
+void dice_layering_app_get_bss(uintptr_t *bss_pa, size_t *bss_size)
+{
+	static char dice_layering_app_bss[4U * GRANULE_SIZE] __aligned(GRANULE_SIZE);
+
+	*bss_pa = (uintptr_t)dice_layering_app_bss;
+	*bss_size = sizeof(dice_layering_app_bss);
+}
+
+void dice_layering_app_init(void)
+{
+	unsigned int cpuid = my_cpuid();
+	uintptr_t granule_pas[DICE_LAYERING_APP_PAGE_COUNT];
+	int ret;
+
+	if (dice_layering_app_init_done[cpuid]) {
+		return;
+	}
+
+	for (size_t i = 0U; i < DICE_LAYERING_APP_PAGE_COUNT; ++i) {
+		granule_pas[i] =
+			(uintptr_t)&rmm_dice_layering_app_pages[cpuid][i][0];
+	}
+
+	ret = dice_layering_app_init_data(
+		&rmm_dice_layering_app_datas[cpuid],
+		granule_pas,
+		DICE_LAYERING_APP_PAGE_COUNT,
+		&rmm_dice_layering_app_pages[cpuid][0][0]);
+	if (ret != 0) {
+		ERROR("DICE: Failed to initialize app instance on CPU %u\n", cpuid);
+		return;
+	}
+
+	ret = dice_layering_app_init_crypto(&rmm_dice_layering_app_datas[cpuid]);
+	if (ret != 0) {
+		ERROR("DICE: Failed to initialize DICE crypto on CPU %u (%d)\n",
+		      cpuid, ret);
+		return;
+	}
+
+	INFO("DICE: Layering app initialized and verified on CPU %u\n", cpuid);
+	dice_layering_app_init_done[cpuid] = true;
+}
+
+struct app_data_cfg *dice_layering_app_get_data_cfg(void)
+{
+	unsigned int cpuid = my_cpuid();
+
+	assert(dice_layering_app_init_done[cpuid]);
+	return &rmm_dice_layering_app_datas[cpuid];
+}
+
+int dice_layering_app_init_realm_identity(struct crypto_identity *dice_id,
+					  unsigned char *rim,
+					  unsigned char *rpv,
+					  enum hash_algo hash_alg)
+{
+	unsigned long ret;
+	struct app_data_cfg *app_data;
+	size_t copied = 0U;
+	size_t chunk_size;
+
+	assert(dice_layering_app_init_done[my_cpuid()]);
+
+	app_data = dice_layering_app_get_data_cfg();
+
+	app_map_shared_page(app_data);
+	assert(app_data->el2_shared_page != NULL);
+	(void)memcpy(app_data->el2_shared_page, rim, MAX_MEASUREMENT_SIZE);
+	(void)memcpy((uint8_t *)app_data->el2_shared_page + MAX_MEASUREMENT_SIZE,
+		     rpv, RPV_SIZE);
+	app_unmap_shared_page(app_data);
+
+	SIMD_FPU_ALLOW(
+		ret = app_run(app_data, DICE_LAYERING_APP_FUNC_ID_REALM_INIT,
+			      (unsigned long)hash_alg, 0UL, 0UL, 0UL));
+
+	while (app_data->exit_flag == APP_EXIT_SVC_YIELD_FLAG) {
+		if (copied >= sizeof(struct crypto_identity)) {
+			return -EINVAL;
+		}
+
+		chunk_size = sizeof(struct crypto_identity) - copied;
+		if (chunk_size > GRANULE_SIZE) {
+			chunk_size = GRANULE_SIZE;
+		}
+
+		app_map_shared_page(app_data);
+		assert(app_data->el2_shared_page != NULL);
+		(void)memcpy((uint8_t *)dice_id + copied,
+			     app_data->el2_shared_page, chunk_size);
+		(void)memset(app_data->el2_shared_page, 0, chunk_size);
+		app_unmap_shared_page(app_data);
+
+		copied += chunk_size;
+
+		SIMD_FPU_ALLOW(ret = app_resume(app_data));
+	}
+
+	if (ret > (unsigned long)INT_MAX) {
+		return -EINVAL;
+	}
+	return (int)ret;
+}
+
+int dice_layering_app_sign_operation(unsigned long op,
+				     struct crypto_identity *dice_id,
+				     uint8_t *payload,
+				     size_t payload_len,
+				     uint8_t *out,
+				     size_t out_size,
+				     size_t *out_len)
+{
+	unsigned long ret;
+	struct app_data_cfg *app_data;
+	uint8_t *key;
+	size_t key_len;
+
+	if (op == DICE_LAYERING_APP_FUNC_ID_SIGN_DSRAK) {
+		key = dice_id->dsrak;
+		key_len = sizeof(dice_id->dsrak);
+	} else if (op == DICE_LAYERING_APP_FUNC_ID_SIGN_DSRIK) {
+		key = dice_id->dsrik;
+		key_len = sizeof(dice_id->dsrik);
+	} else {
+		return -EINVAL;
+	}
+
+	if ((key_len + payload_len) > GRANULE_SIZE) {
+		return -EINVAL;
+	}
+
+	assert(dice_layering_app_init_done[my_cpuid()]);
+	app_data = dice_layering_app_get_data_cfg();
+
+	app_map_shared_page(app_data);
+	assert(app_data->el2_shared_page != NULL);
+	(void)memcpy(app_data->el2_shared_page, key, key_len);
+	(void)memcpy((uint8_t *)app_data->el2_shared_page + key_len,
+		     payload, payload_len);
+	app_unmap_shared_page(app_data);
+
+	SIMD_FPU_ALLOW(
+		ret = app_run(app_data, op, key_len, payload_len, out_size, 0UL));
+
+	assert(app_data->exit_flag != APP_EXIT_SVC_YIELD_FLAG);
+
+	if (ret != 0UL) {
+		app_map_shared_page(app_data);
+		if (app_data->el2_shared_page != NULL) {
+			(void)memset(app_data->el2_shared_page, 0, GRANULE_SIZE);
+		}
+		app_unmap_shared_page(app_data);
+		return -EINVAL;
+	}
+
+	app_map_shared_page(app_data);
+	assert(app_data->el2_shared_page != NULL);
+	(void)memcpy(out_len, app_data->el2_shared_page, sizeof(size_t));
+	if (*out_len > out_size) {
+		(void)memset(app_data->el2_shared_page, 0, GRANULE_SIZE);
+		app_unmap_shared_page(app_data);
+		return -EINVAL;
+	}
+	(void)memcpy(out, (uint8_t *)app_data->el2_shared_page + sizeof(size_t),
+		     *out_len);
+	(void)memset(app_data->el2_shared_page, 0, GRANULE_SIZE);
+	app_unmap_shared_page(app_data);
+
+	return 0;
+}
