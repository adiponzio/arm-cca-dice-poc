+/*
+ * Copy the DICE layering data passed via plat_data into the cached manifest buffer.
+ *
+ * Return updated offset.
+ */
+static size_t copy_dice_data(size_t offset)
+{
+	uintptr_t plat_data = local_core_manifest->plat_data;
+	struct dice_rmm_data *cached_dice;
+	size_t size = sizeof(struct dice_rmm_data);
+
+	if (plat_data == 0UL) {
+		return offset;
+	}
+
+	offset = round_up(offset, sizeof(uint64_t));
+
+	/* Ensure DICE data fits in the cached manifest buffer */
+	assert((offset + size) <= GRANULE_SIZE);
+
+	cached_dice = (struct dice_rmm_data *)((uintptr_t)cached_manifest + offset);
+
+	(void)memcpy((void *)cached_dice, (const void *)plat_data, size);
+
+	local_core_manifest->plat_data = (uintptr_t)cached_dice;
+
+	inv_dcache_range((uintptr_t)cached_dice, size);
+
+	return (offset + size);
+}
