+#
+
+if(RMM_CBMC_STATIC_ANALYSIS)
+    add_library(rmm-app-dice-layering-elf INTERFACE)
+    return()
+endif()
+
+add_subdirectory("mbedtls_dice_layering")
+
+include("${CMAKE_CURRENT_SOURCE_DIR}/../../common/el0_app/CommonApp.cmake")
+
+set(DICE_LAYERING_APP_ID 104)
+
+arm_config_option(
+    NAME RMM_NUM_PAGES_PER_DICE_LAYERING_APP_STACK
+    HELP "Number of pages to use for the DICE Layering app stack"
+    TYPE STRING
+    DEFAULT 4
+    ADVANCED)
+
+arm_config_option(
+    NAME RMM_NUM_PAGES_PER_DICE_LAYERING_APP_HEAP
+    HELP "Number of pages to use for the DICE Layering app heap"
+    TYPE STRING
+    DEFAULT 4
+    ADVANCED)
+
+add_el0_app(
+    APP_NAME dice_layering
+    APP_ID ${DICE_LAYERING_APP_ID}
+    APP_DISPLAY_NAME "dice_layering_app"
+    STACK_SIZE_VAR RMM_NUM_PAGES_PER_DICE_LAYERING_APP_STACK
+    HEAP_SIZE_VAR RMM_NUM_PAGES_PER_DICE_LAYERING_APP_HEAP
+    SOURCES
+        "src/dice_layering_app.c"
+        "src/dice_layering_crypto.c"
+    LINK_LIBRARIES
+        rmm-app-dice-layering-mbedtls
+        rmm-lib-common
+        rmm-lib-debug
+        rmm-lib-pcpu_data
+        rmm-lib-smc
+)
+
+target_include_directories(rmm-app-dice-layering-elf
+    PRIVATE
