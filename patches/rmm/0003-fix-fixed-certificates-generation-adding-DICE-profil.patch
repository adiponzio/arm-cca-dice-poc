+static int add_key_identifiers(mbedtls_x509write_cert *crt,
+			       mbedtls_pk_context *subject_pk,
+			       mbedtls_pk_context *issuer_pk)
+{
+	int ret;
+	unsigned char pub_buf[256];
+	unsigned char hash[32];
+	size_t hash_len;
+	unsigned char ext_buf[64];
+	unsigned char *p;
+	size_t ext_len;
+
+	/* Subject Key Identifier (SKID) */
+	ret = mbedtls_pk_write_pubkey_der(subject_pk, pub_buf, sizeof(pub_buf));
+	if (ret < 0) return ret;
+
+	if (psa_hash_compute(PSA_ALG_SHA_256,
+			     pub_buf + sizeof(pub_buf) - ret, ret,
+			     hash, sizeof(hash), &hash_len) != PSA_SUCCESS) {
+		return -1;
+	}
+
+	ext_len = 0;
+	p = ext_buf + sizeof(ext_buf);
+
+	/* SKID is a standard ASN.1 OCTET STRING */
+	ret = mbedtls_asn1_write_octet_string(&p, ext_buf, hash, 20);
+	if (ret < 0) return ret;
+	ext_len += ret;
+
+	ret = mbedtls_x509write_crt_set_extension(crt, "\x55\x1D\x0E", 3, 0, p, ext_len);
+	if (ret != 0) return ret;
+
+
+	/* Authority Key Identifier (AKID) */
+	ret = mbedtls_pk_write_pubkey_der(issuer_pk, pub_buf, sizeof(pub_buf));
+	if (ret < 0) return ret;
+
+	if (psa_hash_compute(PSA_ALG_SHA_256,
+			     pub_buf + sizeof(pub_buf) - ret, ret,
+			     hash, sizeof(hash), &hash_len) != PSA_SUCCESS) {
+		return -1;
+	}
+
+	ext_len = 0;
+	p = ext_buf + sizeof(ext_buf);
+
+	/* AKID is a SEQUENCE containing an IMPLICIT [0] KeyIdentifier */
+	ret = mbedtls_asn1_write_octet_string(&p, ext_buf, hash, 20);
+	if (ret < 0) return ret;
+	/* Overwrite standard OCTET STRING tag (0x04) with context-specific [0] (0x80) */
+	*p = MBEDTLS_ASN1_CONTEXT_SPECIFIC | 0;
+	ext_len += ret;
+
+	ret = mbedtls_asn1_write_len(&p, ext_buf, ext_len);
+	if (ret < 0) return ret;
+	ext_len += ret;
+
+	ret = mbedtls_asn1_write_tag(&p, ext_buf,
+				     MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE);
+	if (ret < 0) return ret;
+	ext_len += ret;
+
+	ret = mbedtls_x509write_crt_set_extension(crt, "\x55\x1D\x23", 3, 0, p, ext_len);
+	return ret;
+}
+
+/*
+ * Builds a DICE TCB Info ASN.1 DER payload containing ONLY the fwid.
+ */
+static int build_fwid_only_tcb_info(unsigned char *buf, size_t buf_size,
+				    const unsigned char *fw_hash, size_t fw_hash_len)
+{
+	int ret;
+	size_t len = 0;
+
+	/* Mbed TLS writes backwards from the end of the buffer */
+	unsigned char *p = buf + buf_size;
+	unsigned char *start = buf;
+
+	/* [6] IMPLICIT SEQUENCE OF FWID: fwids */
+	size_t fwid_len = 0;
+
+	/* Write digest */
+	ret = mbedtls_asn1_write_octet_string(&p, start, fw_hash, fw_hash_len);
+	if (ret < 0) return ret;
+	fwid_len += ret;
+
+	/* Write hashAlg (OID) SHA256 */
+	switch (fw_hash_len) {
+	case 32: /*SHA256*/
+		ret = mbedtls_asn1_write_oid(&p, start,
+					     MBEDTLS_OID_DIGEST_ALG_SHA256,
+					     sizeof(MBEDTLS_OID_DIGEST_ALG_SHA256) - 1);
+		break;
+	case 64: /*SHA512*/
+		ret = mbedtls_asn1_write_oid(&p, start,
+					     MBEDTLS_OID_DIGEST_ALG_SHA512,
+					     sizeof(MBEDTLS_OID_DIGEST_ALG_SHA512) - 1);
+		break;
+	}
+
+	if (ret < 0) return ret;
+	fwid_len += ret;
+
+	/* Wrap in standard SEQUENCE tag (0x30) for the single FWID item */
+	ret = mbedtls_asn1_write_len(&p, start, fwid_len);
+	if (ret < 0) return ret;
+	fwid_len += ret;
+	ret = mbedtls_asn1_write_tag(&p, start,
+				     MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE);
+	if (ret < 0) return ret;
+	fwid_len += ret;
+
+	/* 4. Wrap in IMPLICIT [6] tag (0xA6 = CONSTRUCTED | CONTEXT_SPECIFIC | 6) */
+	ret = mbedtls_asn1_write_len(&p, start, fwid_len);
+	if (ret < 0) return ret;
+	len += fwid_len + ret;
+
+	ret = mbedtls_asn1_write_tag(&p, start,
+				     MBEDTLS_ASN1_CONTEXT_SPECIFIC | MBEDTLS_ASN1_CONSTRUCTED | 6);
+	if (ret < 0) return ret;
+	len += ret;
+
+	/* Wrap everything in the master DiceTcbInfo SEQUENCE (0x30) */
+	ret = mbedtls_asn1_write_len(&p, start, len);
+	if (ret < 0) return ret;
+	len += ret;
+
+	ret = mbedtls_asn1_write_tag(&p, start,
+				     MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE);
+	if (ret < 0) return ret;
+	len += ret;
+
+	memmove(buf, p, len);
+
+	return (int)len;
+}
+
 int generate_dice_certificate(psa_key_id_t subject_key_id,
 			      psa_key_id_t issuer_key_id,
 			      const char *subject_name,
 			      const char *issuer_name,
 			      uint8_t *out_der, size_t max_out_size,
-			      size_t *cert_len)
+			      size_t *cert_len,
+			      uint8_t *rim, size_t rim_len)
 {
 	int ret;
 	mbedtls_pk_context subject_pk;
@@ -306,6 +448,11 @@ int generate_dice_certificate(psa_key_id_t subject_key_id,
 	mbedtls_x509write_cert crt;
 	mbedtls_mpi serial;
 
+	unsigned char tcb_info[128];
+	size_t tcb_info_len;
+
+	unsigned char serial_bytes[8];
+
 	/* Standard RNG context needed by the X.509 module for internal formatting */
 	//mbedtls_ctr_drbg_context ctr_drbg;
 	//mbedtls_entropy_context entropy;
@@ -350,7 +497,20 @@ int generate_dice_certificate(psa_key_id_t subject_key_id,
 	ret = mbedtls_x509write_crt_set_validity(&crt, "20240101000000", "20991231235959");
 	if (ret != 0) goto cleanup;
 
-	mbedtls_mpi_lset(&serial, 1);
+	///* Generate a random serial number */
+	if (psa_generate_random(serial_bytes, sizeof(serial_bytes)) != PSA_SUCCESS) {
+		ret = -1;
+		goto cleanup;
+	}
+
+	/* Ensure that the generated number is non negative */
+	serial_bytes[0] &= 0x7F;
+
+	ret = mbedtls_mpi_read_binary(&serial, serial_bytes, sizeof(serial_bytes));
+	if (ret != 0) goto cleanup;
+
+	//mbedtls_mpi_lset(&serial, 1);
+
 	ret = mbedtls_x509write_crt_set_serial(&crt, &serial);
 	if (ret != 0) goto cleanup;
 
@@ -361,9 +521,26 @@ int generate_dice_certificate(psa_key_id_t subject_key_id,
 	ret = mbedtls_x509write_crt_set_basic_constraints(&crt, 0, 0);
 	if (ret != 0) goto cleanup;
 
-	ret = mbedtls_x509write_crt_set_key_usage(&crt, MBEDTLS_X509_KU_KEY_CERT_SIGN);
+	ret = mbedtls_x509write_crt_set_key_usage(&crt, MBEDTLS_X509_KU_DIGITAL_SIGNATURE);
 	if (ret != 0) goto cleanup;
 
+	ret = add_key_identifiers(&crt, &subject_pk, &issuer_pk);
+	if (ret != 0) goto cleanup;
+
+	ret = build_fwid_only_tcb_info(tcb_info, sizeof(tcb_info),
+				       rim, rim_len);
+	(void)rim_len;
+	tcb_info_len = (size_t)ret;
+
+	if (ret < 0) goto cleanup;
+
+	tcb_info_len = (size_t)ret;
+	ret = mbedtls_x509write_crt_set_extension(&crt,
+                                                  "\x67\x81\x05\x05\x04\x01", 6,
+                                                  0, /* Non-critical */
+                                                  tcb_info, tcb_info_len);
+        if (ret != 0) goto cleanup;
+
 	/* clean the memory for the certificate */
 	memset(out_der, 0, max_out_size);
 
