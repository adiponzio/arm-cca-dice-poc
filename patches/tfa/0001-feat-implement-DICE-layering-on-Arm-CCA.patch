+#if defined(DICE_LAYERING) && defined(IMAGE_BL31)
+
+/*
+ * Derive a seed through an HKDF algorithm.
+ *
+ * Parameters:
+ *
+ *   input, input_len: input to the HKDF
+ *   output, output_len: output of the HKDF
+ */
+int crypto_mod_derive_seed(const void *input, size_t input_len,
+			   void *output, size_t output_len)
+{
+	assert(crypto_lib_desc.derive_seed != NULL);
+	assert(input != NULL);
+	assert(input_len != 0);
+	assert(output != NULL);
+	assert(output_len != 0);
+
+	return crypto_lib_desc.derive_seed(input, input_len, output, output_len);
+}
+/*
+ * Derive a keypair deterministically from a seed.
+ *
+ * Parameters:
+ *
+ *   seed, seed_len: seed for key derivation
+ *   out, out_len: export buffer for the generated public key
+ *   key_id: generated keypair identifier
+ */
+int crypto_mod_derive_keypair_deterministic(void *seed, size_t seed_len,
+					    //void *out, size_t *out_len,
+					    uint32_t *key_id)
+{
+	assert(crypto_lib_desc.derive_keypair_deterministic != NULL);
+	assert(seed != NULL);
+	assert(seed_len != 0);
+	//assert(out != NULL);
+	//assert(out_len != NULL);
+	assert(key_id != NULL);
+
+	//return crypto_lib_desc.derive_keypair_deterministic(seed, seed_len, out,
+	//						    out_len, key_id);
+	return crypto_lib_desc.derive_keypair_deterministic(seed, seed_len,
+							    key_id);
+}
+/*
+ * Generate a certificate and export it in DER encoding.
+ *
+ * Parameters:
+ *
+ *   subject_key_id: id of the subject key
+ *   issuer_key_id: id of the issuer key
+ *   subject_name: name of the subject to put in the
+ *                 certificate
+ *   issuer_name: name of the issuer to put in the
+ *                certificate
+ *   out_der: buffer to output the certificate
+ *   max_out_size: out_der buffer size
+ *   cert_len: actual certificate length
+ */
+int crypto_mod_generate_dice_certificate(uint32_t subject_key_id,
+					 uint32_t issuer_key_id,
+					 const char *subject_name,
+					 const char *issuer_name,
+					 uint8_t *out_der, size_t max_out_size,
+					 size_t *cert_len)
+{
+	assert(crypto_lib_desc.generate_dice_certificate != NULL);
+	assert(subject_key_id != 0);
+	assert(issuer_key_id != 0);
+	assert(subject_name != NULL);
+	assert(issuer_name != NULL);
+	assert(out_der != NULL);
+	assert(max_out_size != 0);
+	assert(cert_len != NULL);
+
+	return crypto_lib_desc.generate_dice_certificate(subject_key_id, issuer_key_id,
+							 subject_name, issuer_name,
+							 out_der, max_out_size,
+							 cert_len);
+}
+/*
+ * Import a keypair inside the vault from an array.
+ *
+ * Parameters:
+ *   - key, key_len: input key buffer
+ *   - key_id: identifier for the imported key
+ *	       in the vault
+ */
+int crypto_mod_import_keypair(uint8_t *key, size_t key_len,
+			      uint32_t *key_id)
+{
+	assert(crypto_lib_desc.import_keypair != NULL);
+	assert(key != NULL);
+	assert(key_len != 0);
+	assert(key_id != NULL);
+
+	return crypto_lib_desc.import_keypair(key, key_len, key_id);
+}
+#endif /* defined(DICE_LAYERING) && defined(IMAGE_BL31) */
 /* Perform end of psa crypto usage calls to finish */
 void crypto_mod_finish(void)
 {
