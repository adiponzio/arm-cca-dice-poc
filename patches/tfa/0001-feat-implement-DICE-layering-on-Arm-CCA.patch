+++ b/include/drivers/dice_layering/dice_layering.h
@@ -0,0 +1,43 @@
+#ifndef _DICE_LAYERING_H_
+#define _DICE_LAYERING_H_
+
+#include <common/bl_common.h>
+#include <drivers/auth/crypto_mod.h>
+
+#define CDI_LEN      U(32)
+#define TCI_LEN      U(32)
+#define SEC_KEY_LEN  U(32)
+#define SEED_LEN     (CDI_LEN + TCI_LEN)
+#define CERT_MAX_LEN U(512)
+
+/*
+ * Data structure with the dice layering objects that must be passed
+ * to the rmm.
+ */
+struct dice_manifest_data {
+	/*
+	 * The CDI is computed as HKDF(CDI(TFA) || TCI(RMM))
+	 */
+	uint8_t cdi_rmm[32];
+	/*
+	 * Certificate of the RAK public key. The RAK is deterministically generated
+	 * from the cdi_rmm. So, the RMM can re-derive it. The usage of a different
+	 * key can be detected from the verifier since the entire CoT must is sent.
+	 */
+	uint8_t cert_rak[400];
+	size_t cert_rak_len;
+	/*
+	 * Certificate of the TFA public key. This is the parent of the
+	 * RAK certificate in the CoT.
+	 */
+	uint8_t cert_tfa[400];
+	size_t cert_tfa_len;
+};
+
+int dice_layering_measure_image(unsigned int image_id, image_info_t *image_data);
+
+void save_tci_in_shared_ram(void);
+void read_tci_from_shared_ram(void);
+void dice_layering_prepare_rmm_data(void);
+void zero_global_buffers(void);
+#endif /*_DICE_LAYERING_H_*/
