+/*
+ * Since the amount of busy memory in the shared ram can vary depending
+ * on several factors, write the value in the last 64 bytes.
+ */
+#define TCI_RMM_ADDRESS (SHARED_RAM_BASE + SHARED_RAM_SIZE - CRYPTO_MD_MAX_SIZE)
+
+static uint8_t tci_rmm[CRYPTO_MD_MAX_SIZE];
+static size_t tci_rmm_len = 0;
+
+#ifdef IMAGE_BL31
+uint8_t cdi_rmm[CDI_LEN];
+size_t cdi_rmm_len = 0;
+
+uint8_t rmm_cert[CERT_MAX_LEN];
+size_t rmm_cert_len = CERT_MAX_LEN;
+
+uint8_t tfa_cert[CERT_MAX_LEN];
+size_t tfa_cert_len = 0;
+#endif /* IMAGE_BL31 */
+
+int dice_layering_measure_image(unsigned int image_id, image_info_t *image_data)
+{
+	int rc = 0;
+
+	INFO("MEASURE RMM TCI\n");
+	/* Calculate hash */
+	rc = crypto_mod_calc_hash(CRYPTO_MD_SHA256, (void*)image_data->image_base,
+				  image_data->image_size, (unsigned char*)tci_rmm);
+
+	return rc;
+}
+
+/*
+ * The TCI(rmm) is passed from BL2 to BL31 through the shared memory area.
+ *
+ * save_tci_in_shared_ram() copies the value from a buffer to the shared
+ * memory.
+ *
+ * read_tci_from_shared_ram() copy the value from the shared
+ * memory to the .bss section, where the tci_rmm buffer is defined.
+ *
+ * TODO: consider a zero-copy approach to minimize the memory overhead.
+ */
+void save_tci_in_shared_ram(void)
+{
+	uint8_t *tci_rmm_shared_ram = (uint8_t *)TCI_RMM_ADDRESS;
+
+	memcpy(tci_rmm_shared_ram, tci_rmm, TCI_LEN);
+	INFO("Save RMM TCI in the shared ram at 0x%x\n", TCI_RMM_ADDRESS);
+}
+
+void read_tci_from_shared_ram(void)
+{
+	uint8_t *tci_rmm_shared_ram = (uint8_t *)TCI_RMM_ADDRESS;
+
+	if (sizeof(tci_rmm) >= TCI_LEN) {
+		tci_rmm_len = TCI_LEN;
+		memcpy(tci_rmm, tci_rmm_shared_ram, tci_rmm_len);
+	}
+
+	INFO("Read RMM TCI from the shared ram at 0x%x\n", TCI_RMM_ADDRESS);
+}
+
+#ifdef IMAGE_BL31
+static void dump_hex_buffer(const char *title, const uint8_t *buf, size_t len)
+{
+	INFO("%s (%zu bytes):\n", title, len);
+
+	if (buf == NULL || len == 0) {
+		INFO("  (Empty or NULL buffer)\n");
+		return;
+	}
+
+	for (size_t i = 0; i < len; i += 16) {
+		char line_buf[64] = {0};
+		size_t offset = 0;
+
+		for (size_t j = 0; j < 16 && (i + j) < len; j++) {
+			snprintf(line_buf + offset, sizeof(line_buf) - offset,
+			         "%02X ", buf[i + j]);
+			offset += 3;
+		}
+
+		INFO("  %04X: %s\n", (unsigned int)i, line_buf);
+	}
+}
+
+void dice_layering_prepare_rmm_data(void)
+{
+	/*
+	 * Hardcoded values:
+	 *   - cdi0
+	 *   - tfa secret key
+	 *   - tfa certificate (global variable)
+	 */
+	uint8_t cdi0[CDI_LEN];
+	size_t cdi0_len = 0;
+
+	uint8_t tfa_seck[SEC_KEY_LEN];
+	size_t tfa_seck_len = 0;
+
+	/*
+	 * cdi_rmm_seed will contain CDI(0)||TCI(RMM)
+	 */
+	uint8_t cdi_rmm_seed[SEED_LEN];
+	size_t cdi_rmm_seed_len = 0;
+
+	uint32_t rmm_key_id;
+	uint32_t tfa_key_id;
+
+	int rc;
+
+	crypto_mod_init();
+
+	get_cdi0(cdi0, sizeof(cdi0), &cdi0_len);
+	get_tfa_seck(tfa_seck, sizeof(tfa_seck), &tfa_seck_len);
+	get_tfa_cert(tfa_cert, sizeof(tfa_cert), &tfa_cert_len);
+
+	read_tci_from_shared_ram();
+
+	/*
+	 * Populate the buffer for CDI(RMM) generation seed.
+	 */
+	if (sizeof(cdi_rmm_seed) >= cdi0_len + tci_rmm_len) {
+		memcpy(cdi_rmm_seed, cdi0, cdi0_len);
+		memcpy(cdi_rmm_seed + cdi0_len, tci_rmm, tci_rmm_len);
+		cdi_rmm_seed_len = cdi0_len + tci_rmm_len;
+	}
+
+	/* Feed the vault to generate the CDI value for the RMM */
+	rc = crypto_mod_derive_seed(cdi_rmm_seed, cdi_rmm_seed_len,
+				    cdi_rmm, CDI_LEN);
+	assert(rc == 0);
+	cdi_rmm_len = CDI_LEN;
+	INFO("Derived CDI RMM\n");
+
+	/* Use the CDI value to generate a key pair */
+	rc = crypto_mod_derive_keypair_deterministic(cdi_rmm, cdi_rmm_len,
+						     &rmm_key_id);
+	assert(rc == 0);
+	INFO("Derived RMM key\n");
+
+	/* Import the hardcoded tfa keypair inside the vault */
+	rc = crypto_mod_import_keypair(tfa_seck, tfa_seck_len, &tfa_key_id);
+	assert(rc == 0);
+	INFO("Imported TFA key\n");
+
+	/* Generate the certificate signed with the TFA key */
+	rc = crypto_mod_generate_dice_certificate(rmm_key_id, tfa_key_id,
+						  "CN=RMM,O=CCA_Machine",
+					     	  "CN=TFA,O=CCA_Machine",
+					     	  rmm_cert, sizeof(rmm_cert),
+						  &rmm_cert_len);
+	assert(rc == 0);
+	INFO("Generated RMM cert\n");
+
+	/* Only for debug purposes. */
+	dump_hex_buffer("TCI1", tci_rmm, tci_rmm_len);
+	dump_hex_buffer("CDI RMM", cdi_rmm, cdi_rmm_len);
+	dump_hex_buffer("RMM Cert", rmm_cert, rmm_cert_len);
+
+	/* Once the RMM_CDI have been generated, along with the certificate,
+	 * the other dice values are not needed anymore.
+	 *
+	 * Such buffers must be zero-ed for security reasons.
+	 */
+	memset(cdi0, 0, sizeof(cdi0));
+	memset(tfa_seck, 0, sizeof(tfa_seck));
+	memset(cdi_rmm_seed, 0, sizeof(cdi_rmm_seed));
+
+	crypto_mod_finish();
+}
+
+void zero_global_buffers(void)
+{
+	uint8_t *shared = (uint8_t *)TCI_RMM_ADDRESS;
+
+	/* Clean shared memory for TCI*/
+	memset(shared, 0, CRYPTO_MD_MAX_SIZE);
+	/* Clean global buffer for TCI*/
+	memset(tci_rmm, 0, sizeof(tci_rmm));
+	/* Clean global buffer from CDI RMM*/
+	memset(cdi_rmm, 0, sizeof(cdi_rmm));
+}
+#endif /* IMAGE_BL31 */
