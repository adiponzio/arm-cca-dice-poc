@@ -0,0 +1,28 @@
+DICE_LAYERING ?= 0
+
+ifeq (${DICE_LAYERING},1)
+
+    # Define the source files for your DICE framework
+    DICE_LAYERING_SOURCES	:=	drivers/dice_layering/dice_layering.c
+    DICE_LAYERING_SOURCES	+=	drivers/dice_layering/dice_layering_hardcoded.c
+
+    # If your header is in the global 'include/' directory, TF-A already
+    # knows about it. If you put it in a custom non-standard folder,
+    # uncomment the line below to add it to the include path:
+     INCLUDES			+=	-Iinclude/drivers/dice_layering/
+
+    # Append the sources to the bootloader stages that need them.
+    # DICE typically runs in BL1 (Root of Trust), BL2, and BL31.
+    # If you aren't using DICE in BL1 yet, you can comment that line out.
+    #BL1_SOURCES			+=	${DICE_LAYERING_SOURCES}
+    BL2_SOURCES			+=	${DICE_LAYERING_SOURCES}
+    BL31_SOURCES		+=	${DICE_LAYERING_SOURCES}
+
+    BL31_SOURCES += drivers/auth/crypto_mod.c
+    BL31_SOURCES += drivers/auth/mbedtls/mbedtls_psa_crypto.c
+    BL31_SOURCES += ${MBEDTLS_SOURCES}
+    # Export this flag to the C preprocessor so you can wrap your C code
+    # in #if ENABLE_DICE_LAYERING blocks
+    #$(eval $(call add_define,DICE_LAYERING))
+
+endif
