+#include <platform_def.h>
+#include <psa/crypto.h>
+
+#ifdef IMAGE_BL31
+#include <mbedtls/asn1write.h>
+#include <mbedtls/bignum.h>
+#include <mbedtls/oid.h>
+#include <mbedtls/pk.h>
+#include <mbedtls/x509.h>
+#include <mbedtls/x509_crt.h>
+#endif
+
+CASSERT(sizeof(struct dice_tci) <= DICE_SHARED_RAM_SIZE,
+	dice_tci_exceeds_shared_ram_size);
+
+#ifdef IMAGE_BL2
+static struct dice_tci tci_rmm;
+
+static void dice_store_tci_shared_ram(const struct dice_tci *tci)
+{
+	volatile uint8_t *dst = (volatile uint8_t *)DICE_SHARED_RAM_BASE;
+	const uint8_t *src = (const uint8_t *)tci;
+
+	for (size_t i = 0U; i < sizeof(struct dice_tci); i++) {
+		dst[i] = src[i];
+	}
+
+	flush_dcache_range(DICE_SHARED_RAM_BASE, sizeof(struct dice_tci));
+}
+
+/*
+ * Compute SHA-256 hash (tci_rmm) of the loaded RMM binary in BL2 using PSA Crypto
+ * and store it in Secure Shared RAM so BL31 can access it.
+ */
+int dice_layering_measure_image(unsigned int image_id, image_info_t *image_data)
+{
+	psa_status_t status;
+
+	(void)image_id;
+	INFO("DICE: Measuring RMM image (base=0x%lx, size=0x%x)\n",
+	     image_data->image_base, image_data->image_size);
+
+	memset(&tci_rmm, 0, sizeof(tci_rmm));
+
+	status = psa_hash_compute(PSA_ALG_SHA_256,
+				  (const uint8_t *)image_data->image_base,
+				  image_data->image_size,
+				  tci_rmm.value,
+				  sizeof(tci_rmm.value),
+				  &tci_rmm.len);
+	if (status != PSA_SUCCESS) {
+		ERROR("DICE: psa_hash_compute failed (%d)\n", (int)status);
+		return (int)status;
+	}
+
+	tci_rmm.alg = HASH_ALG_SHA_256;
+
+	dice_store_tci_shared_ram(&tci_rmm);
+	INFO("DICE: Stored tci_rmm at 0x%lx (len=%zu)\n",
+	     (unsigned long)DICE_SHARED_RAM_BASE, tci_rmm.len);
+
+	return 0;
+}
+#endif /* IMAGE_BL2 */
+
+#ifdef IMAGE_BL31
+static struct dice_tci tci_rmm;
+static struct dice_rmm_data rmm_dice_data;
+
+static void dice_load_and_clear_tci_shared_ram(struct dice_tci *tci)
+{
+	volatile uint8_t *shared = (volatile uint8_t *)DICE_SHARED_RAM_BASE;
+	uint8_t *dst = (uint8_t *)tci;
+
+	inv_dcache_range(DICE_SHARED_RAM_BASE, sizeof(struct dice_tci));
+
+	for (size_t i = 0U; i < sizeof(struct dice_tci); i++) {
+		dst[i] = shared[i];
+		shared[i] = 0U;
+	}
+
+	flush_dcache_range(DICE_SHARED_RAM_BASE, sizeof(struct dice_tci));
+}
+
+/*
+ * Derive a value through HKDF-SHA256 with NULL salt and NULL info.
+ */
+static int derive_seed(const void *input, size_t input_len,
+		       void *output, size_t output_len)
+{
+	psa_status_t status;
+	psa_key_derivation_operation_t deriv_op = PSA_KEY_DERIVATION_OPERATION_INIT;
+
+	status = psa_key_derivation_setup(&deriv_op, PSA_ALG_HKDF(PSA_ALG_SHA_256));
+	if (status != PSA_SUCCESS) {
+		return (int)status;
+	}
+
+	status = psa_key_derivation_input_bytes(&deriv_op,
+						PSA_KEY_DERIVATION_INPUT_SALT,
+						NULL, 0U);
+	if (status != PSA_SUCCESS) {
+		goto end;
+	}
+
+	status = psa_key_derivation_input_bytes(&deriv_op,
+						PSA_KEY_DERIVATION_INPUT_SECRET,
+						input, input_len);
+	if (status != PSA_SUCCESS) {
+		goto end;
+	}
+
+	status = psa_key_derivation_input_bytes(&deriv_op,
+						PSA_KEY_DERIVATION_INPUT_INFO,
+						NULL, 0U);
+	if (status != PSA_SUCCESS) {
+		goto end;
+	}
+
+	status = psa_key_derivation_output_bytes(&deriv_op, output, output_len);
+
+end:
+	psa_key_derivation_abort(&deriv_op);
+	return (int)status;
+}
+
+/*
+ * Derive an ECDSA P-256 keypair deterministically from a seed via HKDF-SHA256.
+ * This matches RMM's derive_keypair_deterministic() byte-for-byte.
+ */
+static int derive_keypair_deterministic(const void *seed, size_t seed_len,
+					psa_key_id_t *key_id)
+{
+	psa_status_t status;
+	psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
+	psa_key_derivation_operation_t deriv_op = PSA_KEY_DERIVATION_OPERATION_INIT;
+	psa_key_id_t seed_id = PSA_KEY_ID_NULL;
+
+	psa_set_key_type(&attributes, PSA_KEY_TYPE_DERIVE);
+	psa_set_key_usage_flags(&attributes, PSA_KEY_USAGE_DERIVE);
+	psa_set_key_algorithm(&attributes, PSA_ALG_HKDF(PSA_ALG_SHA_256));
+
+	status = psa_import_key(&attributes, seed, seed_len, &seed_id);
+	if (status != PSA_SUCCESS) {
+		return (int)status;
+	}
+
+	attributes = psa_key_attributes_init();
+
+	status = psa_key_derivation_setup(&deriv_op, PSA_ALG_HKDF(PSA_ALG_SHA_256));
+	if (status != PSA_SUCCESS) {
+		goto end;
+	}
+
+	status = psa_key_derivation_input_bytes(&deriv_op,
+						PSA_KEY_DERIVATION_INPUT_SALT,
+						NULL, 0U);
+	if (status != PSA_SUCCESS) {
+		goto end;
+	}
+
+	status = psa_key_derivation_input_key(&deriv_op,
+					      PSA_KEY_DERIVATION_INPUT_SECRET,
+					      seed_id);
+	if (status != PSA_SUCCESS) {
+		goto end;
+	}
+
+	status = psa_key_derivation_input_bytes(&deriv_op,
+						PSA_KEY_DERIVATION_INPUT_INFO,
+						NULL, 0U);
+	if (status != PSA_SUCCESS) {
+		goto end;
+	}
+
+	psa_set_key_type(&attributes,
+			 PSA_KEY_TYPE_ECC_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1));
+	psa_set_key_bits(&attributes, 256U);
+	psa_set_key_usage_flags(&attributes,
+				PSA_KEY_USAGE_SIGN_HASH | PSA_KEY_USAGE_EXPORT);
+	psa_set_key_algorithm(&attributes,
+			      PSA_ALG_DETERMINISTIC_ECDSA(PSA_ALG_SHA_256));
+
+	status = psa_key_derivation_output_key(&attributes, &deriv_op, key_id);
+
+end:
+	psa_key_derivation_abort(&deriv_op);
+	if (seed_id != PSA_KEY_ID_NULL) {
+		psa_destroy_key(seed_id);
+	}
+	return (int)status;
+}
+
+/*
+ * Import an ECDSA P-256 private key into PSA Crypto.
+ */
+static int import_keypair(const uint8_t *key, size_t key_len,
+			  psa_key_id_t *key_id)
+{
+	psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
+
+	psa_set_key_type(&attributes,
+			 PSA_KEY_TYPE_ECC_KEY_PAIR(PSA_ECC_FAMILY_SECP_R1));
+	psa_set_key_bits(&attributes, 256U);
+	psa_set_key_usage_flags(&attributes,
+				PSA_KEY_USAGE_SIGN_HASH | PSA_KEY_USAGE_EXPORT);
+	psa_set_key_algorithm(&attributes,
+			      PSA_ALG_DETERMINISTIC_ECDSA(PSA_ALG_SHA_256));
+
+	return (int)psa_import_key(&attributes, key, key_len, key_id);
+}
+
+/*
+ * Dummy RNG callback for MbedTLS X.509 certificate writing API.
+ * Deterministic ECDSA is configured in PSA Crypto, so signing is deterministic.
+ */
+static int dummy_rng_wrapper(void *ctx, unsigned char *buf, size_t len)
+{
+	(void)ctx;
+	if ((buf != NULL) && (len > 0U)) {
+		memset(buf, 0xAA, len);
+	}
+	return 0;
+}
+
+/*
+ * Manually build and inject the SKID and AKID X.509 extensions using the first
+ * 20 bytes of SHA-256 of SubjectPublicKeyInfo DER (RFC 5280 / DICE profile).
+ */
+static __attribute__((noinline)) int add_key_identifiers(
+	mbedtls_x509write_cert *crt,
+	mbedtls_pk_context *subject_pk,
+	mbedtls_pk_context *issuer_pk)
+{
+	int ret;
+	unsigned char pub_buf[256];
+	unsigned char hash[32];
+	size_t hash_len;
+	unsigned char ext_buf[64];
+	unsigned char *p;
+	size_t ext_len;
+
+	/* Subject Key Identifier (SKID, OID 2.5.29.14 = \x55\x1D\x0E) */
+	ret = mbedtls_pk_write_pubkey_der(subject_pk, pub_buf, sizeof(pub_buf));
+	if (ret < 0) {
+		return ret;
+	}
+
+	if (psa_hash_compute(PSA_ALG_SHA_256,
+			     pub_buf + sizeof(pub_buf) - (size_t)ret,
+			     (size_t)ret,
+			     hash, sizeof(hash), &hash_len) != PSA_SUCCESS) {
+		return -1;
+	}
+
+	ext_len = 0U;
+	p = ext_buf + sizeof(ext_buf);
+
+	ret = mbedtls_asn1_write_octet_string(&p, ext_buf, hash, 20U);
+	if (ret < 0) {
+		return ret;
+	}
+	ext_len += (size_t)ret;
+
+	ret = mbedtls_x509write_crt_set_extension(crt, "\x55\x1D\x0E", 3U, 0,
+						  p, ext_len);
+	if (ret != 0) {
+		return ret;
+	}
+
+	/* Authority Key Identifier (AKID, OID 2.5.29.35 = \x55\x1D\x23) */
+	ret = mbedtls_pk_write_pubkey_der(issuer_pk, pub_buf, sizeof(pub_buf));
+	if (ret < 0) {
+		return ret;
+	}
+
+	if (psa_hash_compute(PSA_ALG_SHA_256,
+			     pub_buf + sizeof(pub_buf) - (size_t)ret,
+			     (size_t)ret,
+			     hash, sizeof(hash), &hash_len) != PSA_SUCCESS) {
+		return -1;
+	}
+
+	ext_len = 0U;
+	p = ext_buf + sizeof(ext_buf);
+
+	ret = mbedtls_asn1_write_octet_string(&p, ext_buf, hash, 20U);
+	if (ret < 0) {
+		return ret;
+	}
+	/* Overwrite OCTET STRING tag (0x04) with IMPLICIT [0] (0x80) */
+	*p = MBEDTLS_ASN1_CONTEXT_SPECIFIC | 0U;
+	ext_len += (size_t)ret;
+
+	ret = mbedtls_asn1_write_len(&p, ext_buf, ext_len);
+	if (ret < 0) {
+		return ret;
+	}
+	ext_len += (size_t)ret;
+
+	ret = mbedtls_asn1_write_tag(&p, ext_buf,
+				     MBEDTLS_ASN1_CONSTRUCTED |
+				     MBEDTLS_ASN1_SEQUENCE);
+	if (ret < 0) {
+		return ret;
+	}
+	ext_len += (size_t)ret;
+
+	return mbedtls_x509write_crt_set_extension(crt, "\x55\x1D\x23", 3U, 0,
+						   p, ext_len);
+}
+
+/*
+ * Build a DICE TcbInfo ASN.1 DER payload (OID 2.23.133.5.4.1) containing the
+ * RMM FWID ([6] IMPLICIT FWIDLIST).
+ */
+static __attribute__((noinline)) int build_fwid_only_tcb_info(
+	unsigned char *buf, size_t buf_size,
+	const unsigned char *fw_hash,
+	size_t fw_hash_len)
+{
+	int ret;
+	size_t len = 0U;
+	size_t fwid_len = 0U;
+	unsigned char *p = buf + buf_size;
+	unsigned char *start = buf;
+
+	/* Write digest OCTET STRING */
+	ret = mbedtls_asn1_write_octet_string(&p, start, fw_hash, fw_hash_len);
+	if (ret < 0) {
+		return ret;
+	}
+	fwid_len += (size_t)ret;
+
+	/* Write hashAlg OID (SHA-256) */
+	ret = mbedtls_asn1_write_oid(&p, start,
+				     MBEDTLS_OID_DIGEST_ALG_SHA256,
+				     sizeof(MBEDTLS_OID_DIGEST_ALG_SHA256) - 1U);
+	if (ret < 0) {
+		return ret;
+	}
+	fwid_len += (size_t)ret;
+
+	/* Wrap in SEQUENCE for the single FWID entry */
+	ret = mbedtls_asn1_write_len(&p, start, fwid_len);
+	if (ret < 0) {
+		return ret;
+	}
+	fwid_len += (size_t)ret;
+
+	ret = mbedtls_asn1_write_tag(&p, start,
+				     MBEDTLS_ASN1_CONSTRUCTED |
+				     MBEDTLS_ASN1_SEQUENCE);
+	if (ret < 0) {
+		return ret;
+	}
+	fwid_len += (size_t)ret;
+
+	/* Wrap in IMPLICIT [6] tag (0xA6) for fwids */
+	ret = mbedtls_asn1_write_len(&p, start, fwid_len);
+	if (ret < 0) {
+		return ret;
+	}
+	len += fwid_len + (size_t)ret;
+
+	ret = mbedtls_asn1_write_tag(&p, start,
+				     MBEDTLS_ASN1_CONTEXT_SPECIFIC |
+				     MBEDTLS_ASN1_CONSTRUCTED | 6U);
+	if (ret < 0) {
+		return ret;
+	}
+	len += (size_t)ret;
+
+	/* Wrap in outer DiceTcbInfo SEQUENCE */
+	ret = mbedtls_asn1_write_len(&p, start, len);
+	if (ret < 0) {
+		return ret;
+	}
+	len += (size_t)ret;
+
+	ret = mbedtls_asn1_write_tag(&p, start,
+				     MBEDTLS_ASN1_CONSTRUCTED |
+				     MBEDTLS_ASN1_SEQUENCE);
+	if (ret < 0) {
+		return ret;
+	}
+	len += (size_t)ret;
+
+	memmove(buf, p, len);
+	return (int)len;
+}
+
+static int generate_dice_certificate(psa_key_id_t subject_key_id,
+				     psa_key_id_t issuer_key_id,
+				     const char *subject_name,
+				     const char *issuer_name,
+				     uint8_t *out_der, size_t max_out_size,
+				     size_t *cert_len,
+				     const uint8_t *fw_tci, size_t fw_tci_len)
+{
+	int ret;
+	mbedtls_pk_context subject_pk;
+	mbedtls_pk_context issuer_pk;
+	mbedtls_x509write_cert crt;
+	mbedtls_mpi serial;
+	unsigned char dice_info_buf[128];
+	size_t dice_info_buf_len;
+
+	mbedtls_pk_init(&subject_pk);
+	mbedtls_pk_init(&issuer_pk);
+	mbedtls_x509write_crt_init(&crt);
+	mbedtls_mpi_init(&serial);
+
+	ret = mbedtls_pk_setup_opaque(&subject_pk, subject_key_id);
+	if (ret != 0) {
+		goto cleanup;
+	}
+
+	ret = mbedtls_pk_setup_opaque(&issuer_pk, issuer_key_id);
+	if (ret != 0) {
+		goto cleanup;
+	}
+
+	mbedtls_x509write_crt_set_version(&crt, MBEDTLS_X509_CRT_VERSION_3);
+	mbedtls_x509write_crt_set_md_alg(&crt, MBEDTLS_MD_SHA256);
+	mbedtls_x509write_crt_set_subject_key(&crt, &subject_pk);
+	mbedtls_x509write_crt_set_issuer_key(&crt, &issuer_pk);
+
+	ret = mbedtls_x509write_crt_set_subject_name(&crt, subject_name);
+	if (ret != 0) {
+		goto cleanup;
+	}
+
+	ret = mbedtls_x509write_crt_set_issuer_name(&crt, issuer_name);
+	if (ret != 0) {
+		goto cleanup;
+	}
+
+	ret = mbedtls_x509write_crt_set_validity(&crt, "19700101000000",
+						 "99991231235959");
+	if (ret != 0) {
+		goto cleanup;
+	}
+
+	ret = mbedtls_mpi_lset(&serial, 2);
+	if (ret != 0) {
+		goto cleanup;
+	}
+	ret = mbedtls_x509write_crt_set_serial(&crt, &serial);
+	if (ret != 0) {
+		goto cleanup;
+	}
+
+	ret = mbedtls_x509write_crt_set_basic_constraints(&crt, 1, 1);
+	if (ret != 0) {
+		goto cleanup;
+	}
+
+	ret = mbedtls_x509write_crt_set_key_usage(&crt,
+						  MBEDTLS_X509_KU_KEY_CERT_SIGN);
+	if (ret != 0) {
+		goto cleanup;
+	}
+
+	ret = add_key_identifiers(&crt, &subject_pk, &issuer_pk);
+	if (ret != 0) {
+		goto cleanup;
+	}
+
+	ret = build_fwid_only_tcb_info(dice_info_buf, sizeof(dice_info_buf),
+				       fw_tci, fw_tci_len);
+	if (ret < 0) {
+		goto cleanup;
+	}
+	dice_info_buf_len = (size_t)ret;
+
+	/* DICE TcbInfo OID: 2.23.133.5.4.1 = \x67\x81\x05\x05\x04\x01 */
+	ret = mbedtls_x509write_crt_set_extension(&crt,
+						  "\x67\x81\x05\x05\x04\x01", 6U,
+						  0, dice_info_buf,
+						  dice_info_buf_len);
+	if (ret != 0) {
+		goto cleanup;
+	}
+
+	memset(out_der, 0, max_out_size);
+	ret = mbedtls_x509write_crt_der(&crt, out_der, max_out_size,
+					dummy_rng_wrapper, NULL);
+	if (ret > 0) {
+		*cert_len = (size_t)ret;
+		memmove(out_der, out_der + max_out_size - (size_t)ret,
+			(size_t)ret);
+		ret = 0;
+	} else if (ret == 0) {
+		ret = -1;
+	}
+
+cleanup:
+	mbedtls_pk_free(&subject_pk);
+	mbedtls_pk_free(&issuer_pk);
+	mbedtls_x509write_crt_free(&crt);
+	mbedtls_mpi_free(&serial);
+
+	return ret;
+}
+
+int dice_layering_init(void)
+{
+	int rc;
+	uint8_t cdi0[DICE_CDI_LEN];
+	size_t cdi0_len = 0U;
+	uint8_t tfa_seck[DICE_SEC_KEY_LEN];
+	size_t tfa_seck_len = 0U;
+	uint8_t cdi_rmm_seed[DICE_CDI_LEN + MAX_HASH_LEN];
+	psa_key_id_t tfa_key_id = PSA_KEY_ID_NULL;
+	psa_key_id_t dice_rak_id = PSA_KEY_ID_NULL;
+
+	/* Initialize MbedTLS heap and PSA Crypto in BL31 */
+	crypto_mod_init();
+
+	memset(&rmm_dice_data, 0, sizeof(rmm_dice_data));
+
+	/* Load and clear TCI_RMM from Secure Shared RAM */
+	dice_load_and_clear_tci_shared_ram(&tci_rmm);
+	if ((tci_rmm.len == 0U) || (tci_rmm.len > MAX_HASH_LEN)) {
+		ERROR("DICE: Invalid tci_rmm length (%zu) read from shared RAM\n",
+		      tci_rmm.len);
+		rc = -1;
+		goto cleanup;
+	}
+
+	/* Obtain CDI0, TF-A secret key, and TF-A root certificate */
+	rc = get_cdi0(cdi0, sizeof(cdi0), &cdi0_len);
+	if (rc != 0) {
+		ERROR("DICE: Failed to get CDI0 (%d)\n", rc);
+		goto cleanup;
+	}
+
+	rc = get_tfa_seck(tfa_seck, sizeof(tfa_seck), &tfa_seck_len);
+	if (rc != 0) {
+		ERROR("DICE: Failed to get TF-A secret key (%d)\n", rc);
+		goto cleanup;
+	}
+
+	rc = get_tfa_cert(rmm_dice_data.cert_tfa,
+			  sizeof(rmm_dice_data.cert_tfa),
+			  &rmm_dice_data.cert_tfa_len);
+	if (rc != 0) {
+		ERROR("DICE: Failed to get TF-A certificate (%d)\n", rc);
+		goto cleanup;
+	}
+
+	/* Construct seed = CDI0 || TCI_RMM and derive CDI_RMM via HKDF-SHA256 */
+	memcpy(cdi_rmm_seed, cdi0, cdi0_len);
+	memcpy(cdi_rmm_seed + cdi0_len, tci_rmm.value, tci_rmm.len);
+
+	rc = derive_seed(cdi_rmm_seed, cdi0_len + tci_rmm.len,
+			 rmm_dice_data.cdi_rmm, sizeof(rmm_dice_data.cdi_rmm));
+	if (rc != 0) {
+		ERROR("DICE: derive_seed (cdi_rmm) failed (%d)\n", rc);
+		goto cleanup;
+	}
+
+	/* Deterministically derive RMM ECDSA P-256 keypair from CDI_RMM */
+	rc = derive_keypair_deterministic(rmm_dice_data.cdi_rmm,
+					  sizeof(rmm_dice_data.cdi_rmm),
+					  &dice_rak_id);
+	if (rc != 0) {
+		ERROR("DICE: derive_keypair_deterministic failed (%d)\n", rc);
+		goto cleanup;
+	}
+
+	/* Import TF-A signing keypair into PSA */
+	rc = import_keypair(tfa_seck, tfa_seck_len, &tfa_key_id);
+	if (rc != 0) {
+		ERROR("DICE: import_keypair (tfa_seck) failed (%d)\n", rc);
+		goto cleanup;
+	}
+
+	/* Generate RMM X.509 certificate signed by TF-A key */
+	rc = generate_dice_certificate(dice_rak_id, tfa_key_id,
+				       "CN=DICE_RAK,O=CCA_Machine",
+				       "CN=TFA,O=CCA_Machine",
+				       rmm_dice_data.cert_dice_rak,
+				       sizeof(rmm_dice_data.cert_dice_rak),
+				       &rmm_dice_data.cert_dice_rak_len,
+				       tci_rmm.value, tci_rmm.len);
+	if (rc != 0) {
+		ERROR("DICE: generate_dice_certificate failed (%d)\n", rc);
+		goto cleanup;
+	}
+
+	INFO("DICE: Prepared RMM DICE data (cert_dice_rak=%zuB, cert_tfa=%zuB)\n",
+	     rmm_dice_data.cert_dice_rak_len, rmm_dice_data.cert_tfa_len);
+
+cleanup:
+	if (dice_rak_id != PSA_KEY_ID_NULL) {
+		psa_destroy_key(dice_rak_id);
+	}
+	if (tfa_key_id != PSA_KEY_ID_NULL) {
+		psa_destroy_key(tfa_key_id);
+	}
+	memset(cdi0, 0, sizeof(cdi0));
+	memset(tfa_seck, 0, sizeof(tfa_seck));
+	memset(cdi_rmm_seed, 0, sizeof(cdi_rmm_seed));
+	memset(&tci_rmm, 0, sizeof(tci_rmm));
+
+	return rc;
+}
+
+const struct dice_rmm_data *dice_layering_get_rmm_data(void)
+{
+	return &rmm_dice_data;
+}
+
+void dice_layering_clear_rmm_data(void)
+{
+	memset(&rmm_dice_data, 0, sizeof(rmm_dice_data));
+}
+#endif /* IMAGE_BL31 */
