+			(uintptr_t)manifest) <= RMM_SHARED_SIZE);
+
+		(void)memcpy((void *)dice_data_ptr,
+			     (const void *)dice_layering_get_rmm_data(),
+			     sizeof(struct dice_rmm_data));
