+
+/*
+ * TF-A's custom libc omits strncpy, which Mbed TLS requires for X.509
+ * Distinguished Name parsing (on non-NUL-terminated slices).
+ */
+static inline char *strncpy(char *dst, const char *src, size_t n)
+{
+	size_t i;
+
+	for (i = 0U; i < n && src[i] != '\0'; i++) {
+		dst[i] = src[i];
+	}
+	for (; i < n; i++) {
+		dst[i] = '\0';
+	}
+	return dst;
+}
