index 000000000..5f4c9ea5c
--- /dev/null
+++ b/drivers/dice_layering/dice_layering.c
@@ -0,0 +1,635 @@
+/*
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
