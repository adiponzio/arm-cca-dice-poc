diff --git a/include/drivers/dice_layering/dice_layering.h b/include/drivers/dice_layering/dice_layering.h
new file mode 100644
index 000000000..46ae3b9d2
--- /dev/null
+++ b/include/drivers/dice_layering/dice_layering.h
@@ -0,0 +1,52 @@
+/*
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#ifndef __DICE_LAYERING_H__
+#define __DICE_LAYERING_H__
+
+#include <stddef.h>
+#include <stdint.h>
+#include <common/bl_common.h>
+
+#define MAX_HASH_LEN		64U
+#define DICE_CDI_LEN		32U
+#define DICE_SEC_KEY_LEN	32U
+#define DICE_MAX_CERT_LEN	1024U
+#define SHA256_HASH_LEN		32U
+
+enum hash_alg {
+	HASH_ALG_SHA_256 = 0,
+	HASH_ALG_SHA_384,
+	HASH_ALG_SHA_512
+};
+
+/*
+ * TCB Component Identifier (TCI)
+ * Measurement of a firmware component passed from BL2 to BL31 via Secure Shared RAM.
+ */
+struct dice_tci {
+	uint8_t value[MAX_HASH_LEN];
+	enum hash_alg alg;
+	size_t len;
+};
+
+/*
+ * DICE layering artefacts passed from BL31 to RMM via manifest->plat_data.
+ * Must match struct dice_rmm_data in RMM's lib/rmm_el3_ifc/include/rmm_el3_ifc.h.
+ */
+struct dice_rmm_data {
+	uint8_t cdi_rmm[DICE_CDI_LEN];
+	uint8_t cert_dice_rak[DICE_MAX_CERT_LEN];
+	size_t cert_dice_rak_len;
+	uint8_t cert_tfa[DICE_MAX_CERT_LEN];
+	size_t cert_tfa_len;
+};
+
+/* Function prototypes */
+int dice_layering_measure_image(unsigned int image_id, image_info_t *image_data);
+int dice_layering_init(void);
+const struct dice_rmm_data *dice_layering_get_rmm_data(void);
+void dice_layering_clear_rmm_data(void);
+
+#endif /* __DICE_LAYERING_H__ */
