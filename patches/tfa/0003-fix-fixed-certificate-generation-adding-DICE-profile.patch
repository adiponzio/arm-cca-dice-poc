+#include <mbedtls/asn1write.h>
+#include <psa/crypto.h>
+
+/*
+ * Manually builds and injects the SKID and AKID X.509 extensions using SHA-256
+ * since SHA-1 is not available in CCA tcb.
+ */
+static int add_key_identifiers(mbedtls_x509write_cert *crt,
+			       mbedtls_pk_context *subject_pk,
+			       mbedtls_pk_context *issuer_pk)
+{
+	int ret;
+	unsigned char pub_buf[256];
+	unsigned char hash[32];
+	size_t hash_len;
+	unsigned char ext_buf[64];
+	unsigned char *p;
+	size_t ext_len;
+
+	/* Subject Key Identifier (SKID) */
+	ret = mbedtls_pk_write_pubkey_der(subject_pk, pub_buf, sizeof(pub_buf));
+	if (ret < 0) return ret;
+
+	if (psa_hash_compute(PSA_ALG_SHA_256,
+			     pub_buf + sizeof(pub_buf) - ret, ret,
+			     hash, sizeof(hash), &hash_len) != PSA_SUCCESS) {
+		return -1;
+	}
+
+	ext_len = 0;
+	p = ext_buf + sizeof(ext_buf);
+
+	/* SKID is a standard ASN.1 OCTET STRING */
+	ret = mbedtls_asn1_write_octet_string(&p, ext_buf, hash, 20); /* Use first 20 bytes */
+	if (ret < 0) return ret;
+	ext_len += ret;
+
+	ret = mbedtls_x509write_crt_set_extension(crt, "\x55\x1D\x0E", 3, 0, p, ext_len);
+	if (ret != 0) return ret;
+
+
+	/* Authority Key Identifier (AKID) */
+	ret = mbedtls_pk_write_pubkey_der(issuer_pk, pub_buf, sizeof(pub_buf));
+	if (ret < 0) return ret;
+
+	if (psa_hash_compute(PSA_ALG_SHA_256,
+			     pub_buf + sizeof(pub_buf) - ret, ret,
+			     hash, sizeof(hash), &hash_len) != PSA_SUCCESS) {
+		return -1;
+	}
+
+	ext_len = 0;
+	p = ext_buf + sizeof(ext_buf);
+
+	/* AKID is a SEQUENCE containing an IMPLICIT [0] KeyIdentifier */
+	ret = mbedtls_asn1_write_octet_string(&p, ext_buf, hash, 20);
+	if (ret < 0) return ret;
+	/* Overwrite standard OCTET STRING tag (0x04) with context-specific [0] (0x80) */
+	*p = MBEDTLS_ASN1_CONTEXT_SPECIFIC | 0;
+	ext_len += ret;
+
+	ret = mbedtls_asn1_write_len(&p, ext_buf, ext_len);
+	if (ret < 0) return ret;
+	ext_len += ret;
+
+	ret = mbedtls_asn1_write_tag(&p, ext_buf,
+				     MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE);
+	if (ret < 0) return ret;
+	ext_len += ret;
+
+	ret = mbedtls_x509write_crt_set_extension(crt, "\x55\x1D\x23", 3, 0, p, ext_len);
+	return ret;
+}
