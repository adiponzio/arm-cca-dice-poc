+/*
+ * Builds a DICE TCB Info ASN.1 DER payload containing ONLY the fwid.
+ */
+static int build_fwid_only_tcb_info(unsigned char *buf, size_t buf_size,
+				    const unsigned char *fw_hash, size_t fw_hash_len)
+{
+	int ret;
+	size_t len = 0;
+
+	/* Mbed TLS writes backwards from the end of the buffer */
+	unsigned char *p = buf + buf_size;
+	unsigned char *start = buf;
+
+	/* [6] IMPLICIT SEQUENCE OF FWID: fwids */
+	size_t fwid_len = 0;
+
+	/* Write digest */
+	ret = mbedtls_asn1_write_octet_string(&p, start, fw_hash, fw_hash_len);
+	if (ret < 0) return ret;
+	fwid_len += ret;
+
+	/* Write hashAlg (OID) SHA256 */
+	ret = mbedtls_asn1_write_oid(&p, start,
+				     MBEDTLS_OID_DIGEST_ALG_SHA256,
+				     sizeof(MBEDTLS_OID_DIGEST_ALG_SHA256) - 1);
+	if (ret < 0) return ret;
+	fwid_len += ret;
+
+	/* Wrap in standard SEQUENCE tag (0x30) for the single FWID item */
+	ret = mbedtls_asn1_write_len(&p, start, fwid_len);
+	if (ret < 0) return ret;
+	fwid_len += ret;
+	ret = mbedtls_asn1_write_tag(&p, start,
+				     MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE);
+	if (ret < 0) return ret;
+	fwid_len += ret;
+
+	/* 4. Wrap in IMPLICIT [6] tag (0xA6 = CONSTRUCTED | CONTEXT_SPECIFIC | 6) */
+	ret = mbedtls_asn1_write_len(&p, start, fwid_len);
+	if (ret < 0) return ret;
+	len += fwid_len + ret;
+
+	ret = mbedtls_asn1_write_tag(&p, start,
+				     MBEDTLS_ASN1_CONTEXT_SPECIFIC | MBEDTLS_ASN1_CONSTRUCTED | 6);
+	if (ret < 0) return ret;
+	len += ret;
+
+	/* Wrap everything in the master DiceTcbInfo SEQUENCE (0x30) */
+	ret = mbedtls_asn1_write_len(&p, start, len);
+	if (ret < 0) return ret;
+	len += ret;
+
+	ret = mbedtls_asn1_write_tag(&p, start,
+				     MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE);
+	if (ret < 0) return ret;
+	len += ret;
+
+	memmove(buf, p, len);
+
+	return (int)len;
+}
 static int generate_dice_certificate(psa_key_id_t subject_key_id,
 				     psa_key_id_t issuer_key_id,
 				     const char *subject_name,
 				     const char *issuer_name,
 				     uint8_t *out_der, size_t max_out_size,
-				     size_t *cert_len)
+				     size_t *cert_len,
+				     uint8_t *fw_tci, size_t fw_tci_len)
 {
 	int ret;
 	mbedtls_pk_context subject_pk;
@@ -757,6 +892,9 @@ static int generate_dice_certificate(psa_key_id_t subject_key_id,
 	mbedtls_x509write_cert crt;
 	mbedtls_mpi serial;
 
+	unsigned char dice_info_buf[128];
+	size_t dice_info_buf_len;
+
 	/* Standard RNG context needed by the X.509 module for internal formatting */
 	//mbedtls_ctr_drbg_context ctr_drbg;
 	//mbedtls_entropy_context entropy;
@@ -803,7 +941,7 @@ static int generate_dice_certificate(psa_key_id_t subject_key_id,
 						 "99991231235959");
 	if (ret != 0) goto cleanup;
 
-	mbedtls_mpi_lset(&serial, 1);
+	mbedtls_mpi_lset(&serial, 2);
 	ret = mbedtls_x509write_crt_set_serial(&crt, &serial);
 	if (ret != 0) goto cleanup;
 
@@ -817,6 +955,20 @@ static int generate_dice_certificate(psa_key_id_t subject_key_id,
 	ret = mbedtls_x509write_crt_set_key_usage(&crt, MBEDTLS_X509_KU_KEY_CERT_SIGN);
 	if (ret != 0) goto cleanup;
 
+	ret = add_key_identifiers(&crt, &subject_pk, &issuer_pk);
+	if (ret != 0) goto cleanup;
+
+	ret = build_fwid_only_tcb_info(dice_info_buf, sizeof(dice_info_buf),
+				       fw_tci, fw_tci_len);
+	if (ret < 0) goto cleanup;
+
+	dice_info_buf_len = (size_t)ret;
+	ret = mbedtls_x509write_crt_set_extension(&crt,
+                                                  "\x67\x81\x05\x05\x04\x01", 6,
+                                                  0, /* Non-critical */
+                                                  dice_info_buf, dice_info_buf_len);
+        if (ret != 0) goto cleanup;
+
 	/* clean the memory for the certificate */
 	memset(out_der, 0, max_out_size);
 
